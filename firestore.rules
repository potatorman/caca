                || isRoomOwner(roomId)
                || isActiveRoomAdmin(roomId)
                || (
                  resource.data.gameId == 'uno'
                  && matchPlayers(resource.data).hasAny([request.auth.uid])
                  && get(
                    /databases/$(database)/documents/rooms/$(roomId)/unoMatches/$(resource.data.round)
                  ).data.status == 'results'
                  && get(
                    /databases/$(database)/documents/rooms/$(roomId)/unoMatches/$(resource.data.round)
                  ).data.winnerId == request.auth.uid
                )
              )
              && request.resource.data.playerIds.hasAll(resource.data.playerIds)
              && request.resource.data.playerIds.hasAll(spectators(resource.data))
              && request.resource.data.playerIds.size()
                == resource.data.playerIds.size() + spectators(resource.data).size()
              && matchPlayers(request.resource.data) == matchPlayers(resource.data)
              && request.resource.data.spectatorIds.size() == 0
              && request.resource.data.readyIds.size() == 0
              && request.resource.data.nextRoundPlayerIds.size() == 0
              && request.resource.data.nextRoundReadyIds.size() == 0
              && request.resource.data.finishedAt is timestamp
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'status', 'playerIds', 'readyIds', 'matchPlayerIds',
                  'spectatorIds', 'nextRoundPlayerIds', 'nextRoundReadyIds',
                  'finishedAt', 'updatedAt'
                ])
            )
            // During UNO results, a removed player can queue themselves for the next lobby.
            || (
              resource.data.gameId == 'uno'
              && resource.data.status == 'results'
              && request.resource.data.status == 'results'
              && !resource.data.playerIds.hasAny([request.auth.uid])
              && !spectators(resource.data).hasAny([request.auth.uid])
              && onlyAddsSelf(resource.data.nextRoundPlayerIds, request.resource.data.nextRoundPlayerIds)
              && request.resource.data.playerIds == resource.data.playerIds
              && request.resource.data.readyIds == resource.data.readyIds
              && matchPlayers(request.resource.data) == matchPlayers(resource.data)
              && spectators(request.resource.data) == spectators(resource.data)
              && request.resource.data.nextRoundReadyIds == resource.data.nextRoundReadyIds
              && request.resource.data.finishedAt == resource.data.finishedAt
              && request.resource.data.hostId == resource.data.hostId
              && request.resource.data.playerIds.size()
                + spectators(resource.data).size()
                + request.resource.data.nextRoundPlayerIds.size() <= 10
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['nextRoundPlayerIds', 'updatedAt'])
            )
            // Return to the same persistent lobby for the next match.
            || (
              resource.data.gameId != 'uno'
              && resource.data.status == 'results'
              && request.resource.data.status == 'lobby'
              && resource.data.finishedAt is timestamp
              && request.time >= resource.data.finishedAt + duration.value(5, 's')
              && request.resource.data.playerIds.hasAll(resource.data.playerIds)
              && request.resource.data.playerIds.hasAll(spectators(resource.data))
              && request.resource.data.playerIds.size()
                == resource.data.playerIds.size() + spectators(resource.data).size()
              && request.resource.data.hostId == resource.data.hostId
              && request.resource.data.readyIds.size() == 0
              && request.resource.data.matchPlayerIds.size() == 0
              && request.resource.data.spectatorIds.size() == 0
              && request.resource.data.nextRoundPlayerIds.size() == 0
              && request.resource.data.nextRoundReadyIds.size() == 0
              && request.resource.data.round == resource.data.round + 1
              && request.resource.data.startedAt == null
              && request.resource.data.countdownEndsAt == null
              && request.resource.data.finishedAt == null
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'status', 'round', 'playerIds', 'readyIds', 'matchPlayerIds', 'spectatorIds',
                  'nextRoundPlayerIds', 'nextRoundReadyIds', 'startedAt',
                  'countdownEndsAt', 'finishedAt', 'updatedAt'
                ])
            )
            // The final active UNO player may leave from the lobby controls and reset the next round.
            || (
              resource.data.status == 'playing'
              && request.resource.data.status == 'lobby'
              && resource.data.gameId == 'uno'
              && resource.data.matchPlayerIds.hasAny([request.auth.uid])
              && !request.resource.data.matchPlayerIds.hasAny([request.auth.uid])
              && request.resource.data.matchPlayerIds.size() == 0
              && onlyRemovesSelf(resource.data.playerIds, request.resource.data.playerIds)
              && !request.resource.data.playerIds.hasAny([request.auth.uid])
              && onlyRemovesSelf(matchPlayers(resource.data), matchPlayers(request.resource.data))
              && matchPlayers(request.resource.data).size() == 0
              && (
                request.resource.data.hostId == resource.data.hostId
                || (
                  request.auth.uid == resource.data.hostId
                  && request.resource.data.playerIds.size() >= 1
                  && request.resource.data.hostId == request.resource.data.playerIds[0]
                )
              )
              && request.resource.data.readyIds.size() == 0
              && request.resource.data.spectatorIds.size() == 0
              && request.resource.data.nextRoundPlayerIds.size() == 0
              && request.resource.data.nextRoundReadyIds.size() == 0
              && request.resource.data.round == resource.data.round + 1
              && request.resource.data.startedAt == null
              && request.resource.data.countdownEndsAt == null
              && request.resource.data.finishedAt == null
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'round', 'hostId', 'playerIds', 'readyIds', 'matchPlayerIds',
                'spectatorIds', 'nextRoundPlayerIds', 'nextRoundReadyIds',
                'startedAt', 'countdownEndsAt', 'finishedAt', 'updatedAt'
              ])
            )
            // A player can leave the room during a match or results without losing the lobby for others.
            || (
              resource.data.status in ['playing', 'results']
              && request.resource.data.status == resource.data.status
              && request.resource.data.hostId == resource.data.hostId
              && onlyRemovesSelf(resource.data.playerIds, request.resource.data.playerIds)
              && onlyRemovesSelf(resource.data.readyIds, request.resource.data.readyIds)
              && onlyRemovesSelf(matchPlayers(resource.data), matchPlayers(request.resource.data))
              && onlyRemovesSelf(spectators(resource.data), spectators(request.resource.data))
              && (
                !resource.data.playerIds.hasAny([request.auth.uid])
                || !request.resource.data.playerIds.hasAny([request.auth.uid])
                || !matchPlayers(resource.data).hasAny([request.auth.uid])
                || !matchPlayers(request.resource.data).hasAny([request.auth.uid])
                || !spectators(request.resource.data).hasAny([request.auth.uid])
              )
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'playerIds', 'readyIds', 'matchPlayerIds', 'spectatorIds', 'updatedAt'
              ])
            )
            // The current host leaves the room while a match or results are active.
            || (
              resource.data.status in ['playing', 'results']
              && request.resource.data.status == resource.data.status
              && request.auth.uid == resource.data.hostId
              && resource.data.playerIds.hasAny([request.auth.uid])
              && !request.resource.data.playerIds.hasAny([request.auth.uid])
              && request.resource.data.playerIds.size() >= 1
              && request.resource.data.hostId == request.resource.data.playerIds[0]
              && onlyRemovesSelf(resource.data.playerIds, request.resource.data.playerIds)
              && onlyRemovesSelf(resource.data.readyIds, request.resource.data.readyIds)
              && onlyRemovesSelf(matchPlayers(resource.data), matchPlayers(request.resource.data))
              && onlyRemovesSelf(spectators(resource.data), spectators(request.resource.data))
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'hostId', 'playerIds', 'readyIds', 'matchPlayerIds', 'spectatorIds', 'updatedAt'
              ])
            )
            // A previous-round host may leave while a match or result screen is active.
            || (
              resource.data.status in ['playing', 'results']
              && request.resource.data.status == resource.data.status
              && request.auth.uid == resource.data.hostId
              && !resource.data.playerIds.hasAny([request.auth.uid])
              && request.resource.data.playerIds == resource.data.playerIds
              && request.resource.data.playerIds.size() >= 1
              && request.resource.data.hostId == request.resource.data.playerIds[0]
              && onlyRemovesSelf(resource.data.readyIds, request.resource.data.readyIds)
              && onlyRemovesSelf(matchPlayers(resource.data), matchPlayers(request.resource.data))
              && onlyRemovesSelf(spectators(resource.data), spectators(request.resource.data))
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'hostId', 'readyIds', 'matchPlayerIds', 'spectatorIds', 'updatedAt'
              ])
            )
            // Room staff can remove a kicked player/spectator and hand host ownership to the next lobby member.
            || (
              (isRoomOwner(roomId) || isActiveRoomAdmin(roomId))
              && (
                request.resource.data.status == resource.data.status
                || (
                  resource.data.status == 'starting'
                  && request.resource.data.status == 'lobby'
                  && request.resource.data.countdownEndsAt == null
                )
              )
              && resource.data.playerIds.hasAll(request.resource.data.playerIds)
              && resource.data.readyIds.hasAll(request.resource.data.readyIds)
              && matchPlayers(resource.data).hasAll(matchPlayers(request.resource.data))
              && spectators(resource.data).hasAll(spectators(request.resource.data))
              && (
                request.resource.data.hostId == resource.data.hostId
                || (
                  (
                    !resource.data.playerIds.hasAny([resource.data.hostId])
                    || !request.resource.data.playerIds.hasAny([resource.data.hostId])
                  )
                  && request.resource.data.playerIds.size() >= 1
                  && request.resource.data.hostId == request.resource.data.playerIds[0]
                )
              )
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'hostId', 'status', 'countdownEndsAt',
                'playerIds', 'readyIds', 'matchPlayerIds', 'spectatorIds',
                'nextRoundPlayerIds', 'nextRoundReadyIds', 'updatedAt'
              ])
              && (
                resource.data.playerIds.size() > request.resource.data.playerIds.size()
                || resource.data.readyIds.size() > request.resource.data.readyIds.size()
                || matchPlayers(resource.data).size() > matchPlayers(request.resource.data).size()
                || spectators(resource.data).size() > spectators(request.resource.data).size()
                || request.resource.data.hostId != resource.data.hostId
              )
            )
          );

        allow delete: if sessionId == 'active'
          && isRoomMember(roomId)
          && (
            request.auth.uid == resource.data.hostId
            || isRoomOwner(roomId)
            || isActiveRoomAdmin(roomId)
          );
      }

      // UNO matches are isolated from the persistent gameSessions/active document.
      // Public match state contains counts and the top card; hands and draw cards
      // live in separate private subcollections.
      match /unoMatches/{roundId} {
        function activeSessionPath() {
          return /databases/$(database)/documents/rooms/$(roomId)/gameSessions/active;
        }

        function matchPath() {
          return /databases/$(database)/documents/rooms/$(roomId)/unoMatches/$(roundId);
        }

        function activeSessionData() {
          return get(activeSessionPath()).data;
        }

        function currentMatch() {
          return get(matchPath()).data;
        }

        function updatedMatch() {
          return getAfter(matchPath()).data;
        }

        // A participant may clean the active finished match. After the lobby
        // advances, members of that lobby may also remove an older finished round.
        function canCleanCurrentUnoRound() {
          return isRoomMember(roomId)
            && activeSessionData().gameId == 'uno'
            && (
              (
                activeSessionData().status in ['playing', 'results']
                && roundId == string(activeSessionData().round)
                && (
                  activeSessionData().playerIds.hasAny([request.auth.uid])
                  || activeSessionData().get('matchPlayerIds', activeSessionData().playerIds)
                    .hasAny([request.auth.uid])
                  || activeSessionData().get('spectatorIds', []).hasAny([request.auth.uid])
                  || activeSessionData().get('nextRoundPlayerIds', []).hasAny([request.auth.uid])
                )
              )
              || (
                activeSessionData().status in ['lobby', 'starting', 'playing', 'results']
                && currentMatch().roomId == roomId
                && roundId == string(currentMatch().round)
                && currentMatch().status == 'results'
                && currentMatch().round < activeSessionData().round
                && (
                  currentMatch().playerIds.hasAny([request.auth.uid])
                  || activeSessionData().playerIds.hasAny([request.auth.uid])
                )
              )
            );
        }

        function removesOnlyCurrentUser(oldList, newList) {
          return oldList.hasAll(newList)
            && oldList.size() == newList.size() + 1
            && oldList.hasAny([request.auth.uid])
            && !newList.hasAny([request.auth.uid]);
        }

        function isActiveMatchPlayer() {
          return isRoomMember(roomId)
            && activeSessionData().gameId == 'uno'
            && activeSessionData().status == 'playing'
            && activeSessionData().get('matchPlayerIds', activeSessionData().playerIds)
              .hasAny([request.auth.uid]);
        }

        // Match-side forfeit authorization depends only on this match's old/new state.
        function isSelfForfeitUpdate() {
          return request.resource.data.get('forfeitedBy', null) == request.auth.uid
            && resource.data.activePlayerIds is list
            && request.resource.data.activePlayerIds is list
            && removesOnlyCurrentUser(resource.data.activePlayerIds, request.resource.data.activePlayerIds)
            && !request.resource.data.activePlayerIds.hasAny([request.auth.uid])
            && (
              (
                request.resource.data.activePlayerIds.size() == 1
                && request.resource.data.status == 'results'
                && request.resource.data.winnerId == request.resource.data.activePlayerIds[0]
              )
              || (
                request.resource.data.activePlayerIds.size() >= 2
                && request.resource.data.status == 'playing'
              )
            );
        }

        function canUpdateUnoMatch() {
          return isRoomMember(roomId)
            && resource.data.status == 'playing'
            && resource.data.activePlayerIds is list
            && resource.data.activePlayerIds.hasAny([request.auth.uid])
            && (
              isSelfForfeitUpdate()
              || (
                activeSessionData().gameId == 'uno'
                && activeSessionData().status == 'playing'
                && activeSessionData().round == resource.data.round
                && activeSessionData().get('matchPlayerIds', activeSessionData().playerIds)
                  .hasAny([request.auth.uid])
              )
            );
        }

        function validUnoMatch(data) {
          return data.roomId == roomId
            && data.round is int
            && data.round >= 1
            && data.status in ['playing', 'results']
            && data.playerIds is list
            && data.playerIds.size() >= 2
            && data.playerIds.size() <= 10
            && data.activePlayerIds is list
            && data.activePlayerIds.size() >= 1
            && data.activePlayerIds.size() <= data.playerIds.size()
            && data.playerIds.hasAll(data.activePlayerIds)
            && data.currentPlayerIndex is int
            && data.currentPlayerIndex >= 0
            && data.currentPlayerIndex < data.activePlayerIds.size()
            && data.currentPlayerUid == data.activePlayerIds[data.currentPlayerIndex]
            && data.drawPile is list
            && data.discardPile is list;
        }

        allow get: if isRoomMember(roomId);
        allow list: if false;

        allow create: if isActiveMatchPlayer()
          && validUnoMatch(request.resource.data)
          && request.resource.data.round == activeSessionData().round
          && request.resource.data.status == 'playing'
          && request.resource.data.playerIds == activeSessionData().matchPlayerIds
          && request.resource.data.activePlayerIds == request.resource.data.playerIds
          && request.resource.data.dealerId == request.auth.uid;

        allow update: if canUpdateUnoMatch()
          && resource.data.status == 'playing'
          && validUnoMatch(request.resource.data)
          && request.resource.data.round == resource.data.round
          && request.resource.data.playerIds == resource.data.playerIds
          && request.resource.data.dealerId == resource.data.dealerId
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            !isSelfForfeitUpdate()
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'activePlayerIds', 'currentPlayerIndex', 'currentPlayerUid',
              'drewCardId', 'status', 'winnerId', 'forfeitedBy',
              'unoPendingUid', 'unoCalled', 'finishedAt', 'updatedAt', 'turnStartedAt'
            ])
          );

        allow delete: if canCleanCurrentUnoRound()
          && (
            resource.data.status == 'results'
            || resource.data.round != activeSessionData().round
            || resource.data.roomId != roomId
          );

        match /hands/{playerId} {
          allow get: if isRoomMember(roomId)
            && request.auth.uid == playerId
            && currentMatch().playerIds.hasAny([request.auth.uid])
            && activeSessionData().matchPlayerIds.hasAny([request.auth.uid]);

          allow list: if false;

          allow create: if isActiveMatchPlayer()
            && updatedMatch().status == 'playing'
            && updatedMatch().playerIds.hasAny([playerId])
            && request.resource.data.cards is list
            && request.resource.data.cards.size() == 7
            && (
              // Initial deal: the dealer creates only their own private hand.
              (
                playerId == request.auth.uid
                && updatedMatch().dealerId == request.auth.uid
              )
              // Recovery: a player may create only their own missing hand.
              || (
                playerId == request.auth.uid
                && currentMatch().status == 'playing'
                && currentMatch().activePlayerIds.hasAny([request.auth.uid])
                && updatedMatch().handCounts[request.auth.uid] == 7
              )
            );

          allow update: if isActiveMatchPlayer()
            && currentMatch().status == 'playing'
            && currentMatch().activePlayerIds.hasAny([playerId])
            && request.resource.data.cards is list
            && request.resource.data.cards.size() <= 108;

          allow delete: if canCleanCurrentUnoRound()
            && currentMatch().playerIds is list
            && currentMatch().playerIds.hasAny([playerId])
            && (
              currentMatch().status == 'results'
              || currentMatch().round != activeSessionData().round
              || currentMatch().roomId != roomId
            );
        }
      }

    }

    match /roomInvites/{inviteCode} {
      // A signed-in user may look up an exact invite code to join a room.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'roomId',
          'roomName',
          'createdAt'
        ])
        && request.resource.data.roomId is string
        && request.resource.data.roomName is string
        && request.resource.data.createdAt is timestamp
        && existsAfter(roomPath(request.resource.data.roomId))
        && getAfter(roomPath(request.resource.data.roomId)).data.ownerId == request.auth.uid;

      allow update: if false;
      allow delete: if signedIn()
        && isRoomOwner(resource.data.roomId);
    }
  }
}
