rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }

    function memberPath(roomId, userId) {
      return /databases/$(database)/documents/rooms/$(roomId)/members/$(userId);
    }

    function userRoomPath(userId, roomId) {
      return /databases/$(database)/documents/users/$(userId)/rooms/$(roomId);
    }

    function banPath(roomId, userId) {
      return /databases/$(database)/documents/rooms/$(roomId)/bans/$(userId);
    }

    function invitePath(inviteCode) {
      return /databases/$(database)/documents/roomInvites/$(inviteCode);
    }

    function isRoomOwner(roomId) {
      return signedIn()
        && exists(roomPath(roomId))
        && get(roomPath(roomId)).data.ownerId == request.auth.uid;
    }

    function isRoomMember(roomId) {
      return signedIn()
        && exists(memberPath(roomId, request.auth.uid))
        && get(memberPath(roomId, request.auth.uid)).data.get('role', 'member')
          in ['owner', 'member', 'admin'];
    }

    function isActiveAdminRecord(memberData) {
      return memberData.get('role', 'member') == 'admin'
        && (
          memberData.get('adminExpiresAt', null) == null
          || memberData.get('adminExpiresAt', request.time) > request.time
        );
    }

    function isActiveRoomAdmin(roomId) {
      return signedIn()
        && exists(memberPath(roomId, request.auth.uid))
        && isActiveAdminRecord(
          get(memberPath(roomId, request.auth.uid)).data
        );
    }

    function isKickableByAdmin(memberData) {
      return memberData.get('role', 'member') == 'member'
        || (
          memberData.get('role', 'member') == 'admin'
          && memberData.get('adminExpiresAt', null) != null
          && memberData.get('adminExpiresAt', request.time) <= request.time
        );
    }

    function canKickRoomMember(roomId, targetUserId) {
      return isRoomOwner(roomId)
        || (
          isActiveRoomAdmin(roomId)
          && exists(memberPath(roomId, targetUserId))
          && isKickableByAdmin(
            get(memberPath(roomId, targetUserId)).data
          )
        );
    }

    function validNickname(value) {
      return value is string && value.size() >= 2 && value.size() <= 24;
    }

    function validAvatarData(value) {
      return value == null
        || (value is string && value.size() <= 120000);
    }

    function validJumpscareImage(value) {
      return value == null
        || (
          value is string
          && value.size() <= 180000
          && value.matches('^data:image/(webp|jpeg);base64,[A-Za-z0-9+/=]+$')
        );
    }

    // User profiles are readable by authenticated users because room members
    // and chat messages display each other's public nickname and avatar.
    match /users/{userId} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'username',
          'usernameLower',
          'nickname',
          'createdAt'
        ])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9_]{3,20}$')
        && request.resource.data.usernameLower is string
        && request.resource.data.usernameLower.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.nickname == request.resource.data.username
        && request.resource.data.createdAt is timestamp;

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nickname',
          'avatarId',
          'avatarData'
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['nickname'])
          || validNickname(request.resource.data.nickname)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['avatarId'])
          || (
            request.resource.data.avatarId is string
            && request.resource.data.avatarId.size() <= 32
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['avatarData'])
          || validAvatarData(request.resource.data.get('avatarData', null))
        );

      allow delete: if signedIn() && request.auth.uid == userId;

      match /rooms/{roomId} {
        allow get, list: if signedIn() && request.auth.uid == userId;

        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['name', 'role', 'joinedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 30
          && request.resource.data.role in ['owner', 'member']
          && request.resource.data.joinedAt is timestamp
          && existsAfter(roomPath(roomId))
          && existsAfter(memberPath(roomId, userId))
          && (
            (
              request.resource.data.role == 'owner'
              && getAfter(roomPath(roomId)).data.ownerId == userId
              && getAfter(memberPath(roomId, userId)).data.role == 'owner'
            )
            || (
              request.resource.data.role == 'member'
              && getAfter(memberPath(roomId, userId)).data.role == 'member'
            )
          );

        allow update: if false;

        allow delete: if signedIn()
          && !existsAfter(memberPath(roomId, userId))
          && (
            request.auth.uid == userId
            || isRoomOwner(roomId)
            || (
              canKickRoomMember(roomId, userId)
              && userId != request.auth.uid
            )
          );
      }
      // Each user owns a private library of exactly three compressed images.
      match /jumpscares/{libraryId} {
        allow get: if signedIn()
          && request.auth.uid == userId
          && libraryId == 'library';
        allow list: if false;

        allow create, update: if signedIn()
          && request.auth.uid == userId
          && libraryId == 'library'
          && request.resource.data.keys().hasAll([
            'slot1', 'slot2', 'slot3', 'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'slot1', 'slot2', 'slot3', 'updatedAt'
          ])
          && validJumpscareImage(request.resource.data.slot1)
          && validJumpscareImage(request.resource.data.slot2)
          && validJumpscareImage(request.resource.data.slot3)
          && request.resource.data.updatedAt is timestamp;

        allow delete: if signedIn()
          && request.auth.uid == userId
          && libraryId == 'library';
      }
    }

    match /rooms/{roomId} {
      allow get: if signedIn()
        && (
          resource.data.ownerId == request.auth.uid
          || isRoomMember(roomId)
        );

      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'name',
          'ownerId',
          'inviteCode',
          'createdAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 30
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.matches('^[A-HJ-NP-Z2-9]{8}$')
        && request.resource.data.createdAt is timestamp;

      allow update: if false;

      // The owner deletes the room only after its child documents and the
      // owner's own membership/list entry have been removed.
      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && !existsAfter(memberPath(roomId, request.auth.uid))
        && !existsAfter(userRoomPath(request.auth.uid, roomId));

      match /members/{memberId} {
        allow get, list: if signedIn()
          && (
            memberId == request.auth.uid
            || isRoomOwner(roomId)
            || isRoomMember(roomId)
          );

        allow create: if signedIn()
          && memberId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'username',
            'role',
            'joinedAt',
            'inviteCodeUsed'
          ])
          && request.resource.data.username is string
          && request.resource.data.role in ['owner', 'member']
          && request.resource.data.joinedAt is timestamp
          && existsAfter(userRoomPath(memberId, roomId))
          && (
            (
              request.resource.data.role == 'owner'
              && getAfter(roomPath(roomId)).data.ownerId == memberId
            )
            || (
              request.resource.data.role == 'member'
              && request.resource.data.inviteCodeUsed is string
              && get(invitePath(request.resource.data.inviteCodeUsed)).data.roomId == roomId
              && !exists(banPath(roomId, memberId))
            )
          );

        // A user can update only their own public room nickname.
        // The room owner alone can grant, renew or revoke admin permissions.
        allow update: if signedIn()
          && (
            (
              memberId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username'])
              && request.resource.data.username is string
              && request.resource.data.username.size() >= 2
              && request.resource.data.username.size() <= 24
            )
            || (
              isRoomOwner(roomId)
              && memberId != request.auth.uid
              && resource.data.get('role', 'member') != 'owner'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'role',
                'adminExpiresAt',
                'adminGrantedAt',
                'adminGrantedBy'
              ])
              && request.resource.data.role in ['admin', 'member']
              && (
                (
                  request.resource.data.role == 'admin'
                  && request.resource.data.adminGrantedBy == request.auth.uid
                  && request.resource.data.adminGrantedAt is timestamp
                  && (
                    request.resource.data.adminExpiresAt == null
                    || request.resource.data.adminExpiresAt is timestamp
                  )
                )
                || (
                  request.resource.data.role == 'member'
                  && request.resource.data.adminExpiresAt == null
                  && request.resource.data.adminGrantedAt == null
                  && request.resource.data.adminGrantedBy == null
                )
              )
            )
            // An admin may only demote their own account after the server-side expiry.
            || (
              memberId == request.auth.uid
              && resource.data.get('role', 'member') == 'admin'
              && resource.data.get('adminExpiresAt', null) is timestamp
              && request.time >= resource.data.adminExpiresAt
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'role',
                'adminExpiresAt',
                'adminGrantedAt',
                'adminGrantedBy'
              ])
              && request.resource.data.role == 'member'
              && request.resource.data.adminExpiresAt == null
              && request.resource.data.adminGrantedAt == null
              && request.resource.data.adminGrantedBy == null
            )
          );

        allow delete: if signedIn()
          && (
            // Members may leave their own room. The owner can also remove
            // their own membership only as part of deleting the whole room.
            (
              memberId == request.auth.uid
              && (
                resource.data.get('role', 'member') != 'owner'
                || (
                  isRoomOwner(roomId)
                  && !existsAfter(roomPath(roomId))
                  && !existsAfter(userRoomPath(memberId, roomId))
                )
              )
            )
            // Owners can remove any other member. Active admins can remove
            // ordinary members and expired admins, but never active admins.
            || (
              memberId != request.auth.uid
              && canKickRoomMember(roomId, memberId)
            )
          );
      }

      match /messages/{messageId} {
        allow read: if isRoomMember(roomId);

        allow create: if isRoomMember(roomId)
          && request.resource.data.keys().hasOnly([
            'text',
            'senderId',
            'senderName',
            'senderAvatarId',
            'createdAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 2000
          && request.resource.data.senderName is string
          && request.resource.data.senderAvatarId is string
          && request.resource.data.createdAt is timestamp;

        allow update: if isRoomMember(roomId)
          && resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'text',
            'editedAt'
          ])
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 2000
          && request.resource.data.editedAt is timestamp;

        allow delete: if isRoomMember(roomId)
          && (
            resource.data.senderId == request.auth.uid
            || isRoomOwner(roomId)
          );
      }

      match /bans/{bannedUserId} {
        // A banned user can verify their own ban; only the room owner can
        // enumerate the room's ban list or change ban records.
        allow get: if signedIn()
          && (
            bannedUserId == request.auth.uid
            || isRoomOwner(roomId)
          );

        allow list: if isRoomOwner(roomId);

        allow create: if isRoomOwner(roomId)
          && bannedUserId != request.auth.uid
          && request.resource.data.keys().hasOnly([
            'username',
            'bannedAt',
            'bannedBy'
          ])
          && request.resource.data.username is string
          && request.resource.data.bannedAt is timestamp
          && request.resource.data.bannedBy == request.auth.uid;

        allow update: if false;
        allow delete: if isRoomOwner(roomId);
      }

      match /pranks/{prankId} {
        // Every room member receives live room-wide prank events.
        allow get: if isRoomMember(roomId);
        allow list: if false;

        // Only the room owner and an active room admin can send an effect.
        // A single fixed document is overwritten so room data cannot grow
        // with every prank click.
        allow create, update: if prankId == 'active'
          && (isRoomOwner(roomId) || isActiveRoomAdmin(roomId))
          && request.resource.data.keys().hasAll([
            'eventId',
            'type',
            'senderId',
            'senderName',
            'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'eventId',
            'type',
            'senderId',
            'senderName',
            'createdAt'
          ])
          && request.resource.data.eventId is string
          && request.resource.data.eventId.size() >= 8
          && request.resource.data.eventId.size() <= 80
          && request.resource.data.type in ['jumpscare', 'shake']
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() >= 1
          && request.resource.data.senderName.size() <= 24
          && request.resource.data.createdAt is timestamp;

        // The room owner removes the fixed event document during room deletion.
        allow delete: if isRoomOwner(roomId);
      }
      // Each room member can send an image to one eligible recipient.
      // Only the addressed user can read the incoming event.
      match /prankInbox/{recipientUid} {
        allow get: if signedIn()
          && recipientUid == request.auth.uid
          && isRoomMember(roomId);
        allow list: if false;

        allow create: if signedIn()
          && isRoomMember(roomId)
          && (isRoomOwner(roomId) || isActiveRoomAdmin(roomId))
          && recipientUid != request.auth.uid
          && recipientUid != get(roomPath(roomId)).data.ownerId
          && exists(memberPath(roomId, recipientUid))
          && (
            isRoomOwner(roomId)
            || isActiveRoomAdmin(roomId)
            || isKickableByAdmin(get(memberPath(roomId, recipientUid)).data)
          )
          && request.resource.data.keys().hasAll([
            'eventId', 'type', 'senderId', 'senderName', 'imageData', 'durationMs', 'sentAt'
          ])
          && request.resource.data.keys().hasOnly([
            'eventId', 'type', 'senderId', 'senderName', 'imageData', 'durationMs', 'sentAt'
          ])
          && request.resource.data.eventId is string
          && request.resource.data.eventId.size() >= 8
          && request.resource.data.eventId.size() <= 80
          && request.resource.data.type == 'custom-jumpscare'
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() >= 1
          && request.resource.data.senderName.size() <= 24
          && request.resource.data.imageData is string
          && validJumpscareImage(request.resource.data.imageData)
          && request.resource.data.durationMs is int
          && request.resource.data.durationMs in [3000, 5000, 10000, 15000]
          && request.resource.data.sentAt is timestamp;

        allow update: if signedIn()
          && isRoomMember(roomId)
          && (isRoomOwner(roomId) || isActiveRoomAdmin(roomId))
          && recipientUid != request.auth.uid
          && recipientUid != get(roomPath(roomId)).data.ownerId
          && exists(memberPath(roomId, recipientUid))
          && (
            isRoomOwner(roomId)
            || isActiveRoomAdmin(roomId)
            || isKickableByAdmin(get(memberPath(roomId, recipientUid)).data)
          )
          && resource.data.sentAt is timestamp
          && request.time > resource.data.sentAt + duration.value(5, 's')
          && request.resource.data.keys().hasAll([
            'eventId', 'type', 'senderId', 'senderName', 'imageData', 'durationMs', 'sentAt'
          ])
          && request.resource.data.keys().hasOnly([
            'eventId', 'type', 'senderId', 'senderName', 'imageData', 'durationMs', 'sentAt'
          ])
          && request.resource.data.eventId is string
          && request.resource.data.eventId.size() >= 8
          && request.resource.data.eventId.size() <= 80
          && request.resource.data.type == 'custom-jumpscare'
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() >= 1
          && request.resource.data.senderName.size() <= 24
          && request.resource.data.imageData is string
          && validJumpscareImage(request.resource.data.imageData)
          && request.resource.data.durationMs is int
          && request.resource.data.durationMs in [3000, 5000, 10000, 15000]
          && request.resource.data.sentAt is timestamp;

        allow delete: if signedIn()
          && (
            recipientUid == request.auth.uid
            || isRoomOwner(roomId)
            || (
              recipientUid != request.auth.uid
              && canKickRoomMember(roomId, recipientUid)
            )
          );
      }
      // One fixed game session per room. All members can read it to watch.
      match /gameSessions/{sessionId} {
        function onlyRemovesSelf(oldList, newList) {
          return oldList.hasAll(newList)
            && (
              oldList.size() == newList.size()
              || (
                oldList.size() == newList.size() + 1
                && oldList.hasAny([request.auth.uid])
                && !newList.hasAny([request.auth.uid])
              )
            );
        }

        function onlyAddsSelf(oldList, newList) {
          return newList.hasAll(oldList)
            && newList.size() == oldList.size() + 1
            && !oldList.hasAny([request.auth.uid])
            && newList.hasAny([request.auth.uid]);
        }

        function matchPlayers(data) {
          return data.keys().hasAny(['matchPlayerIds'])
            ? data.matchPlayerIds
            : (data.status in ['playing', 'results'] ? data.playerIds : []);
        }

        function spectators(data) {
          return data.keys().hasAny(['spectatorIds'])
            ? data.spectatorIds
            : [];
        }

        function validGameSession(data) {
          return data.keys().hasAll([
              'gameId', 'gameName', 'status', 'round', 'hostId',
              'playerIds', 'readyIds', 'nextRoundPlayerIds',
              'nextRoundReadyIds', 'createdAt', 'startedAt', 'updatedAt'
            ])
            && data.keys().hasOnly([
              'gameId', 'gameName', 'status', 'round', 'hostId',
              'playerIds', 'readyIds', 'nextRoundPlayerIds',
              'nextRoundReadyIds', 'matchPlayerIds', 'spectatorIds',
              'createdAt', 'startedAt', 'countdownEndsAt', 'finishedAt', 'updatedAt'
            ])
            && data.gameId is string && data.gameId.size() >= 3 && data.gameId.size() <= 32
            && data.gameName is string && data.gameName.size() >= 2 && data.gameName.size() <= 40
            && data.status in ['lobby', 'starting', 'playing', 'results']
            && data.round is int && data.round >= 1
            && data.hostId is string
            && data.playerIds is list && data.playerIds.size() <= 20
            && (data.gameId != 'uno' || data.playerIds.size() <= 10)
            && data.readyIds is list && data.readyIds.size() <= 20
            && data.readyIds.hasOnly(data.playerIds)
            && data.nextRoundPlayerIds is list && data.nextRoundPlayerIds.size() <= 20
            && data.nextRoundReadyIds is list && data.nextRoundReadyIds.size() <= 20
            && data.nextRoundReadyIds.hasOnly(data.nextRoundPlayerIds)
            && (
              !data.keys().hasAny(['matchPlayerIds'])
              || (
                data.matchPlayerIds is list
                && data.matchPlayerIds.size() <= 20
                && data.matchPlayerIds.hasOnly(data.playerIds)
                && (data.gameId != 'uno' || data.matchPlayerIds.size() <= 10)
              )
            )
            && (
              !data.keys().hasAny(['spectatorIds'])
              || (data.spectatorIds is list && data.spectatorIds.size() <= 10)
            )
            && (!data.keys().hasAny(['countdownEndsAt']) || data.countdownEndsAt == null || data.countdownEndsAt is timestamp)
            && (!data.keys().hasAny(['finishedAt']) || data.finishedAt == null || data.finishedAt is timestamp)
            && data.createdAt is timestamp
            && (data.startedAt == null || data.startedAt is timestamp)
            && data.updatedAt is timestamp;
        }

        allow get: if sessionId == 'active' && isRoomMember(roomId);
        allow list: if false;

        allow create: if sessionId == 'active'
          && isRoomMember(roomId)
          && validGameSession(request.resource.data)
          && request.resource.data.status == 'lobby'
          && request.resource.data.hostId == request.auth.uid
          && request.resource.data.playerIds.size() == 1
          && request.resource.data.playerIds[0] == request.auth.uid
          && request.resource.data.readyIds.size() == 0
          && request.resource.data.matchPlayerIds.size() == 0
          && request.resource.data.spectatorIds.size() == 0
          && request.resource.data.nextRoundPlayerIds.size() == 0
          && request.resource.data.nextRoundReadyIds.size() == 0
          && request.resource.data.round == 1
          && request.resource.data.startedAt == null
          && request.resource.data.countdownEndsAt == null
          && request.resource.data.finishedAt == null;

        allow update: if sessionId == 'active'
          && isRoomMember(roomId)
          && validGameSession(request.resource.data)
          && request.resource.data.gameId == resource.data.gameId
          && request.resource.data.gameName == resource.data.gameName
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            // A room member joins the persistent lobby.
            (
              resource.data.status == 'lobby'
              && request.resource.data.status == 'lobby'
              && request.resource.data.hostId == resource.data.hostId
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['playerIds', 'readyIds', 'updatedAt'])
              && !resource.data.playerIds.hasAny([request.auth.uid])
              && onlyAddsSelf(resource.data.playerIds, request.resource.data.playerIds)
              && (resource.data.gameId != 'uno' || request.resource.data.playerIds.size() <= 10)
              && request.resource.data.readyIds == resource.data.readyIds
              && matchPlayers(request.resource.data) == matchPlayers(resource.data)
              && spectators(request.resource.data) == spectators(resource.data)
            )
            // A lobby member leaves the persistent lobby.
            || (
              resource.data.status == 'lobby'
              && request.resource.data.status == 'lobby'
              && request.resource.data.hostId == resource.data.hostId
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['playerIds', 'readyIds', 'updatedAt'])
              && resource.data.playerIds.hasAny([request.auth.uid])
              && onlyRemovesSelf(resource.data.playerIds, request.resource.data.playerIds)
              && onlyRemovesSelf(resource.data.readyIds, request.resource.data.readyIds)
              && matchPlayers(request.resource.data) == matchPlayers(resource.data)
              && spectators(request.resource.data) == spectators(resource.data)
            )
            // A player toggles their ready state.
            || (
              resource.data.status == 'lobby'
              && request.resource.data.status == 'lobby'
              && request.resource.data.hostId == resource.data.hostId
              && request.resource.data.playerIds == resource.data.playerIds
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['readyIds', 'updatedAt'])
              && (
                onlyAddsSelf(resource.data.readyIds, request.resource.data.readyIds)
                || onlyRemovesSelf(resource.data.readyIds, request.resource.data.readyIds)
              )
            )
            // The host leaves the lobby; the first remaining member inherits ownership.
            || (
              resource.data.status in ['lobby', 'starting']
              && request.resource.data.status == 'lobby'
              && request.auth.uid == resource.data.hostId
              && resource.data.playerIds.hasAny([request.auth.uid])
              && !request.resource.data.playerIds.hasAny([request.auth.uid])
              && request.resource.data.playerIds.size() >= 1
              && request.resource.data.hostId == request.resource.data.playerIds[0]
              && onlyRemovesSelf(resource.data.playerIds, request.resource.data.playerIds)
              && onlyRemovesSelf(resource.data.readyIds, request.resource.data.readyIds)
              && onlyRemovesSelf(matchPlayers(resource.data), matchPlayers(request.resource.data))
              && onlyRemovesSelf(spectators(resource.data), spectators(request.resource.data))
              && request.resource.data.countdownEndsAt == null
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'hostId', 'status', 'countdownEndsAt', 'playerIds', 'readyIds',
                'matchPlayerIds', 'spectatorIds', 'updatedAt'
              ])
            )
            // A previous-round host may no longer be in the current player list.
            // On leaving, ownership still moves to the first persistent lobby member.
            || (
              resource.data.status in ['lobby', 'starting']
              && request.resource.data.status == 'lobby'
              && request.auth.uid == resource.data.hostId
              && !resource.data.playerIds.hasAny([request.auth.uid])
              && request.resource.data.playerIds == resource.data.playerIds
              && request.resource.data.readyIds == resource.data.readyIds
              && request.resource.data.playerIds.size() >= 1
              && request.resource.data.hostId == request.resource.data.playerIds[0]
              && matchPlayers(request.resource.data) == matchPlayers(resource.data)
              && spectators(request.resource.data) == spectators(resource.data)
              && request.resource.data.countdownEndsAt == null
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['hostId', 'status', 'countdownEndsAt', 'updatedAt'])
            )
            // A ready player can cancel the countdown.
            || (
              resource.data.status == 'starting'
              && request.resource.data.status == 'lobby'
              && request.resource.data.hostId == resource.data.hostId
              && request.resource.data.playerIds == resource.data.playerIds
              && request.resource.data.readyIds.size() == resource.data.readyIds.size() - 1
              && onlyRemovesSelf(resource.data.readyIds, request.resource.data.readyIds)
              && !request.resource.data.readyIds.hasAny([request.auth.uid])
              && request.resource.data.countdownEndsAt == null
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'countdownEndsAt', 'readyIds', 'updatedAt'])
            )
            // A player can leave while the countdown is running; the countdown is cancelled.
            || (
              resource.data.status == 'starting'
              && request.resource.data.status == 'lobby'
              && request.resource.data.hostId == resource.data.hostId
              && resource.data.playerIds.hasAny([request.auth.uid])
              && !request.resource.data.playerIds.hasAny([request.auth.uid])
              && onlyRemovesSelf(resource.data.playerIds, request.resource.data.playerIds)
              && onlyRemovesSelf(resource.data.readyIds, request.resource.data.readyIds)
              && matchPlayers(request.resource.data) == matchPlayers(resource.data)
              && spectators(request.resource.data) == spectators(resource.data)
              && request.resource.data.countdownEndsAt == null
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'countdownEndsAt', 'playerIds', 'readyIds', 'updatedAt'])
            )
            // Start the shared countdown when every persistent lobby member is ready.
            || (
              resource.data.status == 'lobby'
              && request.resource.data.status == 'starting'
              && request.resource.data.hostId == resource.data.hostId
              && request.resource.data.playerIds == resource.data.playerIds
              && request.resource.data.readyIds == resource.data.readyIds
              && matchPlayers(request.resource.data) == matchPlayers(resource.data)
              && request.resource.data.playerIds.size() >= 2
              && (resource.data.gameId != 'uno' || request.resource.data.playerIds.size() <= 10)
              && request.resource.data.readyIds.hasAll(request.resource.data.playerIds)
              && request.resource.data.countdownEndsAt is timestamp
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'countdownEndsAt', 'updatedAt'])
            )
            // The countdown starts a match with a frozen player list.
            || (
              resource.data.status == 'starting'
              && request.resource.data.status == 'playing'
              && request.time >= resource.data.countdownEndsAt
              && request.resource.data.playerIds == resource.data.playerIds
              && request.resource.data.matchPlayerIds == request.resource.data.playerIds
              && request.resource.data.readyIds.size() == 0
              && request.resource.data.spectatorIds.size() == 0
              && request.resource.data.startedAt is timestamp
              && request.resource.data.countdownEndsAt == null
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'status', 'matchPlayerIds', 'spectatorIds', 'readyIds',
                  'nextRoundPlayerIds', 'nextRoundReadyIds',
                  'startedAt', 'countdownEndsAt', 'finishedAt', 'updatedAt'
                ])
            )
            // A member who enters the game center during a live match becomes a spectator.
            || (
              resource.data.status == 'playing'
              && request.resource.data.status == 'playing'
              && request.resource.data.hostId == resource.data.hostId
              && request.resource.data.playerIds == resource.data.playerIds
              && matchPlayers(request.resource.data) == matchPlayers(resource.data)
              && request.resource.data.readyIds == resource.data.readyIds
              && !resource.data.playerIds.hasAny([request.auth.uid])
              && !matchPlayers(resource.data).hasAny([request.auth.uid])
              && onlyAddsSelf(spectators(resource.data), spectators(request.resource.data))
              && request.resource.data.playerIds.size() + spectators(request.resource.data).size() <= 10
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['spectatorIds', 'updatedAt'])
            )
            // A current match player can leave the match but remain in the persistent lobby.
            || (
              resource.data.status == 'playing'
              && request.resource.data.status == 'playing'
              && request.resource.data.hostId == resource.data.hostId
              && request.resource.data.playerIds == resource.data.playerIds
              && request.resource.data.readyIds == resource.data.readyIds
              && spectators(request.resource.data) == spectators(resource.data)
              && matchPlayers(resource.data).hasAny([request.auth.uid])
              && onlyRemovesSelf(matchPlayers(resource.data), matchPlayers(request.resource.data))
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['matchPlayerIds', 'updatedAt'])
            )
            // Finish a match: promote every recorded spectator and clear readiness.
            || (
              resource.data.status == 'playing'
              && request.resource.data.status == 'results'
              && (
                request.auth.uid == resource.data.hostId
                || isRoomOwner(roomId)
                || isActiveRoomAdmin(roomId)
                || (
                  resource.data.gameId == 'uno'
                  && getAfter(
                    /databases/$(database)/documents/rooms/$(roomId)/unoMatches/$(resource.data.round)
                  ).data.status == 'results'
                  && getAfter(
                    /databases/$(database)/documents/rooms/$(roomId)/unoMatches/$(resource.data.round)
                  ).data.winnerId == request.auth.uid
                )
              )
              && request.resource.data.playerIds.hasAll(resource.data.playerIds)
              && request.resource.data.playerIds.hasAll(spectators(resource.data))
              && request.resource.data.playerIds.size()
                == resource.data.playerIds.size() + spectators(resource.data).size()
              && matchPlayers(request.resource.data) == matchPlayers(resource.data)
              && request.resource.data.spectatorIds.size() == 0
              && request.resource.data.readyIds.size() == 0
              && request.resource.data.nextRoundPlayerIds.size() == 0
              && request.resource.data.nextRoundReadyIds.size() == 0
              && request.resource.data.finishedAt is timestamp
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'status', 'playerIds', 'readyIds', 'matchPlayerIds',
                  'spectatorIds', 'nextRoundPlayerIds', 'nextRoundReadyIds',
                  'finishedAt', 'updatedAt'
                ])
            )
            // Return to the same persistent lobby for the next match.
            || (
              resource.data.status == 'results'
              && request.resource.data.status == 'lobby'
              && (
                request.auth.uid == resource.data.hostId
                || isRoomOwner(roomId)
                || isActiveRoomAdmin(roomId)
              )
              && request.resource.data.playerIds == resource.data.playerIds
              && request.resource.data.readyIds.size() == 0
              && request.resource.data.matchPlayerIds.size() == 0
              && request.resource.data.spectatorIds.size() == 0
              && request.resource.data.nextRoundPlayerIds.size() == 0
              && request.resource.data.nextRoundReadyIds.size() == 0
              && request.resource.data.round == resource.data.round + 1
              && request.resource.data.startedAt == null
              && request.resource.data.countdownEndsAt == null
              && request.resource.data.finishedAt == null
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'status', 'round', 'readyIds', 'matchPlayerIds', 'spectatorIds',
                  'nextRoundPlayerIds', 'nextRoundReadyIds', 'startedAt',
                  'countdownEndsAt', 'finishedAt', 'updatedAt'
                ])
            )
            // A player can leave the room during a match or results without losing the lobby for others.
            || (
              resource.data.status in ['playing', 'results']
              && request.resource.data.status == resource.data.status
              && request.resource.data.hostId == resource.data.hostId
              && onlyRemovesSelf(resource.data.playerIds, request.resource.data.playerIds)
              && onlyRemovesSelf(resource.data.readyIds, request.resource.data.readyIds)
              && onlyRemovesSelf(matchPlayers(resource.data), matchPlayers(request.resource.data))
              && onlyRemovesSelf(spectators(resource.data), spectators(request.resource.data))
              && (
                !resource.data.playerIds.hasAny([request.auth.uid])
                || !request.resource.data.playerIds.hasAny([request.auth.uid])
                || !matchPlayers(resource.data).hasAny([request.auth.uid])
                || !matchPlayers(request.resource.data).hasAny([request.auth.uid])
                || !spectators(request.resource.data).hasAny([request.auth.uid])
              )
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'playerIds', 'readyIds', 'matchPlayerIds', 'spectatorIds', 'updatedAt'
              ])
            )
            // The current host leaves the room while a match or results are active.
            || (
              resource.data.status in ['playing', 'results']
              && request.resource.data.status == resource.data.status
              && request.auth.uid == resource.data.hostId
              && resource.data.playerIds.hasAny([request.auth.uid])
              && !request.resource.data.playerIds.hasAny([request.auth.uid])
              && request.resource.data.playerIds.size() >= 1
              && request.resource.data.hostId == request.resource.data.playerIds[0]
              && onlyRemovesSelf(resource.data.playerIds, request.resource.data.playerIds)
              && onlyRemovesSelf(resource.data.readyIds, request.resource.data.readyIds)
              && onlyRemovesSelf(matchPlayers(resource.data), matchPlayers(request.resource.data))
              && onlyRemovesSelf(spectators(resource.data), spectators(request.resource.data))
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'hostId', 'playerIds', 'readyIds', 'matchPlayerIds', 'spectatorIds', 'updatedAt'
              ])
            )
            // A previous-round host may leave while a match or result screen is active.
            || (
              resource.data.status in ['playing', 'results']
              && request.resource.data.status == resource.data.status
              && request.auth.uid == resource.data.hostId
              && !resource.data.playerIds.hasAny([request.auth.uid])
              && request.resource.data.playerIds == resource.data.playerIds
              && request.resource.data.playerIds.size() >= 1
              && request.resource.data.hostId == request.resource.data.playerIds[0]
              && onlyRemovesSelf(resource.data.readyIds, request.resource.data.readyIds)
              && onlyRemovesSelf(matchPlayers(resource.data), matchPlayers(request.resource.data))
              && onlyRemovesSelf(spectators(resource.data), spectators(request.resource.data))
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'hostId', 'readyIds', 'matchPlayerIds', 'spectatorIds', 'updatedAt'
              ])
            )
            // Room staff can remove a kicked player/spectator and hand host ownership to the next lobby member.
            || (
              (isRoomOwner(roomId) || isActiveRoomAdmin(roomId))
              && (
                request.resource.data.status == resource.data.status
                || (
                  resource.data.status == 'starting'
                  && request.resource.data.status == 'lobby'
                  && request.resource.data.countdownEndsAt == null
                )
              )
              && resource.data.playerIds.hasAll(request.resource.data.playerIds)
              && resource.data.readyIds.hasAll(request.resource.data.readyIds)
              && matchPlayers(resource.data).hasAll(matchPlayers(request.resource.data))
              && spectators(resource.data).hasAll(spectators(request.resource.data))
              && (
                request.resource.data.hostId == resource.data.hostId
                || (
                  (
                    !resource.data.playerIds.hasAny([resource.data.hostId])
                    || !request.resource.data.playerIds.hasAny([resource.data.hostId])
                  )
                  && request.resource.data.playerIds.size() >= 1
                  && request.resource.data.hostId == request.resource.data.playerIds[0]
                )
              )
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'hostId', 'status', 'countdownEndsAt',
                'playerIds', 'readyIds', 'matchPlayerIds', 'spectatorIds',
                'nextRoundPlayerIds', 'nextRoundReadyIds', 'updatedAt'
              ])
              && (
                resource.data.playerIds.size() > request.resource.data.playerIds.size()
                || resource.data.readyIds.size() > request.resource.data.readyIds.size()
                || matchPlayers(resource.data).size() > matchPlayers(request.resource.data).size()
                || spectators(resource.data).size() > spectators(request.resource.data).size()
                || request.resource.data.hostId != resource.data.hostId
              )
            )
          );

        allow delete: if sessionId == 'active'
          && isRoomMember(roomId)
          && (
            request.auth.uid == resource.data.hostId
            || isRoomOwner(roomId)
            || isActiveRoomAdmin(roomId)
          );
      }

      // UNO matches are isolated from the persistent gameSessions/active document.
      // Public match state contains counts and the top card; hands and draw cards
      // live in separate private subcollections.
      match /unoMatches/{roundId} {
        function activeSessionPath() {
          return /databases/$(database)/documents/rooms/$(roomId)/gameSessions/active;
        }

        function matchPath() {
          return /databases/$(database)/documents/rooms/$(roomId)/unoMatches/$(roundId);
        }

        function handPath(playerId) {
          return /databases/$(database)/documents/rooms/$(roomId)/unoMatches/$(roundId)/hands/$(playerId);
        }

        function activeSessionData() {
          return get(activeSessionPath()).data;
        }

        function matchData() {
          return get(matchPath()).data;
        }

        function matchDataAfter() {
          return getAfter(matchPath()).data;
        }

        function validUnoCard(card) {
          return card is map
            && card.keys().hasAll(['id', 'color', 'type', 'value'])
            && card.id is string
            && card.id.size() >= 3
            && card.id.size() <= 40
            && (card.color == null || card.color in ['red', 'yellow', 'green', 'blue'])
            && card.type in ['number', 'skip', 'reverse', 'draw2', 'wild', 'wild4']
            && card.value is string;
        }

        function validUnoState(data) {
          return data.keys().hasAll([
              'roomId', 'round', 'status', 'playerIds', 'activePlayerIds',
              'dealerId', 'direction', 'currentPlayerIndex', 'currentPlayerUid',
              'activeColor', 'topCard', 'discardPile', 'drawOrder', 'drawIndex',
              'handCounts', 'drewCardId', 'drewCardPlayable', 'unoPendingUid',
              'unoCalled', 'winnerId', 'turnNumber', 'lastActionType',
              'lastActionBy', 'lastActionTargetUid', 'lastActionDrawnCards',
              'lastPlayedCard', 'deckRecycledBy', 'createdAt', 'updatedAt',
              'turnStartedAt'
            ])
            && data.keys().hasOnly([
              'roomId', 'round', 'status', 'playerIds', 'activePlayerIds',
              'dealerId', 'direction', 'currentPlayerIndex', 'currentPlayerUid',
              'activeColor', 'topCard', 'discardPile', 'drawOrder', 'drawIndex',
              'handCounts', 'drewCardId', 'drewCardPlayable', 'unoPendingUid',
              'unoCalled', 'winnerId', 'turnNumber', 'lastActionType',
              'lastActionBy', 'lastActionTargetUid', 'lastActionDrawnCards',
              'lastPlayedCard', 'deckRecycledBy', 'createdAt', 'updatedAt',
              'turnStartedAt', 'finishedAt'
            ])
            && data.roomId == roomId
            && data.round is int && data.round >= 1
            && data.status in ['playing', 'results']
            && data.playerIds is list
            && data.playerIds.size() >= 2
            && data.playerIds.size() <= 10
            && data.activePlayerIds is list
            && data.activePlayerIds.size() >= 1
            && data.activePlayerIds.size() <= data.playerIds.size()
            && data.playerIds.hasAll(data.activePlayerIds)
            && data.dealerId is string
            && data.playerIds.hasAny([data.dealerId])
            && data.direction in [-1, 1]
            && data.currentPlayerIndex is int
            && data.currentPlayerIndex >= 0
            && data.currentPlayerIndex < data.activePlayerIds.size()
            && data.currentPlayerUid == data.activePlayerIds[data.currentPlayerIndex]
            && data.activeColor in ['red', 'yellow', 'green', 'blue']
            && validUnoCard(data.topCard)
            && data.discardPile is list
            && data.discardPile.size() >= 1
            && data.discardPile.size() <= 108
            && data.drawOrder is list
            && data.drawOrder.size() >= 1
            && data.drawOrder.size() <= 2000
            && data.drawIndex is int
            && data.drawIndex >= 0
            && data.drawIndex <= data.drawOrder.size()
            && data.handCounts is map
            && data.handCounts.keys().hasAll(data.playerIds)
            && (data.drewCardId == null || data.drewCardId is string)
            && data.drewCardPlayable is bool
            && (data.unoPendingUid == null || data.unoPendingUid is string)
            && data.unoCalled is bool
            && (data.winnerId == null || data.winnerId is string)
            && data.turnNumber is int
            && data.turnNumber >= 1
            && data.lastActionType is string
            && data.lastActionBy is string
            && (data.lastActionTargetUid == null || data.lastActionTargetUid is string)
            && data.lastActionDrawnCards is list
            && data.lastActionDrawnCards.size() <= 4
            && (data.lastPlayedCard == null || validUnoCard(data.lastPlayedCard))
            && (data.deckRecycledBy == null || data.deckRecycledBy is string)
            && data.createdAt is timestamp
            && data.updatedAt is timestamp
            && data.turnStartedAt is timestamp
            && (!data.keys().hasAny(['finishedAt']) || data.finishedAt is timestamp);
        }

        function validUnoStateChanges() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'activePlayerIds', 'currentPlayerIndex', 'currentPlayerUid',
            'direction', 'topCard', 'activeColor', 'discardPile', 'drawOrder',
            'drawIndex', 'handCounts', 'drewCardId', 'drewCardPlayable',
            'unoPendingUid', 'unoCalled', 'winnerId', 'turnNumber',
            'lastActionType', 'lastActionBy', 'lastActionTargetUid',
            'lastActionDrawnCards', 'lastPlayedCard', 'deckRecycledBy',
            'updatedAt', 'turnStartedAt', 'finishedAt'
          ])
          && request.resource.data.roomId == resource.data.roomId
          && request.resource.data.round == resource.data.round
          && request.resource.data.playerIds == resource.data.playerIds
          && request.resource.data.dealerId == resource.data.dealerId
          && request.resource.data.createdAt == resource.data.createdAt
          && validUnoState(request.resource.data);
        }

        function validCurrentTurnAction() {
          return request.auth.uid == resource.data.currentPlayerUid
            && request.resource.data.lastActionBy == request.auth.uid
            && request.resource.data.turnNumber == resource.data.turnNumber + 1
            && request.resource.data.activePlayerIds == resource.data.activePlayerIds
            && request.resource.data.lastActionType in ['play', 'draw2', 'wild4', 'draw', 'pass']
            && (
              request.resource.data.status == 'playing'
              || (
                request.resource.data.status == 'results'
                && request.resource.data.winnerId == request.auth.uid
                && getAfter(activeSessionPath()).data.status == 'results'
                && getAfter(handPath(request.auth.uid)).data.cards.size() == 0
              )
            );
        }

        function validUnoCall() {
          return request.auth.uid == resource.data.unoPendingUid
            && resource.data.unoCalled == false
            && request.resource.data.unoCalled == true
            && request.resource.data.unoPendingUid == resource.data.unoPendingUid
            && request.resource.data.turnNumber == resource.data.turnNumber
            && request.resource.data.currentPlayerUid == resource.data.currentPlayerUid
            && request.resource.data.lastActionType == 'callUno'
            && request.resource.data.lastActionBy == request.auth.uid
            && request.resource.data.status == 'playing';
        }

        function validUnoCatch() {
          return request.auth.uid == resource.data.currentPlayerUid
            && request.resource.data.lastActionBy == request.auth.uid
            && request.resource.data.lastActionType == 'catchUno'
            && request.resource.data.lastActionTargetUid == resource.data.unoPendingUid
            && resource.data.unoPendingUid != null
            && resource.data.unoCalled == false
            && request.resource.data.unoPendingUid == null
            && request.resource.data.turnNumber == resource.data.turnNumber
            && request.resource.data.status == 'playing'
            && request.resource.data.lastActionDrawnCards.size() == 2;
        }

        function validPlayerRemovalSync() {
          return activeSessionData().status == 'playing'
            && activeSessionData().matchPlayerIds is list
            && activeSessionData().matchPlayerIds.hasAny([request.auth.uid])
            && request.resource.data.activePlayerIds == activeSessionData().matchPlayerIds
            && request.resource.data.activePlayerIds.size() < resource.data.activePlayerIds.size()
            && request.resource.data.currentPlayerUid in request.resource.data.activePlayerIds
            && request.resource.data.lastActionType == 'player-left'
            && request.resource.data.lastActionBy == request.auth.uid
            && request.resource.data.turnNumber == resource.data.turnNumber
            && (
              (
                request.resource.data.activePlayerIds.size() > 1
                && request.resource.data.status == 'playing'
              )
              || (
                request.resource.data.activePlayerIds.size() == 1
                && request.resource.data.status == 'results'
                && request.resource.data.winnerId == request.resource.data.activePlayerIds[0]
                && getAfter(activeSessionPath()).data.status == 'results'
              )
            );
        }

        function validTimedOutTurn() {
          return request.auth.uid in resource.data.activePlayerIds
            && request.resource.data.lastActionBy == request.auth.uid
            && request.resource.data.lastActionType == 'timeout'
            && request.resource.data.status == 'playing'
            && request.resource.data.turnNumber == resource.data.turnNumber + 1
            && request.resource.data.activePlayerIds == resource.data.activePlayerIds
            && request.time > resource.data.turnStartedAt + duration.value(90, 's');
        }

        allow get: if isRoomMember(roomId);
        allow list: if false;

        allow create: if isRoomMember(roomId)
          && exists(activeSessionPath())
          && activeSessionData().gameId == 'uno'
          && activeSessionData().status == 'playing'
          && activeSessionData().round == request.resource.data.round
          && activeSessionData().matchPlayerIds == request.resource.data.playerIds
          && activeSessionData().matchPlayerIds.hasAny([request.auth.uid])
          && validUnoState(request.resource.data)
          && request.resource.data.status == 'playing'
          && request.resource.data.activePlayerIds == request.resource.data.playerIds
          && request.resource.data.dealerId == request.auth.uid
          && request.resource.data.currentPlayerIndex == 0
          && request.resource.data.currentPlayerUid == request.resource.data.playerIds[0]
          && request.resource.data.direction == 1
          && request.resource.data.winnerId == null
          && request.resource.data.drawOrder.size() == 108
          && request.resource.data.drawIndex == request.resource.data.playerIds.size() * 7 + 1
          && request.resource.data.unoPendingUid == null
          && request.resource.data.unoCalled == false;

        allow update: if isRoomMember(roomId)
          && exists(activeSessionPath())
          && activeSessionData().gameId == 'uno'
          && activeSessionData().round == resource.data.round
          && resource.data.status == 'playing'
          && activeSessionData().status == 'playing'
          && validUnoStateChanges()
          && (
            validCurrentTurnAction()
            || validUnoCall()
            || validUnoCatch()
            || validPlayerRemovalSync()
            || validTimedOutTurn()
          );

        allow delete: if false;

        match /hands/{playerId} {
          function currentMatch() {
            return get(matchPath()).data;
          }

          function updatedMatch() {
            return getAfter(matchPath()).data;
          }

          allow get: if isRoomMember(roomId)
            && request.auth.uid == playerId
            && currentMatch().playerIds.hasAny([request.auth.uid]);

          allow list: if false;

          allow create: if isRoomMember(roomId)
            && updatedMatch().status == 'playing'
            && updatedMatch().dealerId == request.auth.uid
            && updatedMatch().playerIds.hasAny([playerId])
            && request.resource.data.keys().hasAll(['cards', 'createdAt', 'updatedAt'])
            && request.resource.data.keys().hasOnly(['cards', 'createdAt', 'updatedAt'])
            && request.resource.data.cards is list
            && request.resource.data.cards.size() == 7
            && request.resource.data.createdAt is timestamp
            && request.resource.data.updatedAt is timestamp;

          allow update: if isRoomMember(roomId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cards', 'updatedAt'])
            && request.resource.data.cards is list
            && request.resource.data.updatedAt is timestamp
            && (
              (
                request.auth.uid == playerId
                && updatedMatch().lastActionBy == request.auth.uid
                && updatedMatch().lastActionType in ['play', 'draw2', 'wild4']
                && resource.data.cards.size() == request.resource.data.cards.size() + 1
                && resource.data.cards.hasAll(request.resource.data.cards)
                && resource.data.cards.hasAny([updatedMatch().lastPlayedCard])
                && !request.resource.data.cards.hasAny([updatedMatch().lastPlayedCard])
                && updatedMatch().handCounts[playerId] == request.resource.data.cards.size()
              )
              || (
                request.auth.uid == playerId
                && updatedMatch().lastActionBy == request.auth.uid
                && updatedMatch().lastActionType == 'draw'
                && request.resource.data.cards.size() == resource.data.cards.size() + 1
                && request.resource.data.cards.hasAll(resource.data.cards)
                && updatedMatch().lastActionDrawnCards.size() == 1
                && request.resource.data.cards.hasAll(updatedMatch().lastActionDrawnCards)
                && updatedMatch().handCounts[playerId] == request.resource.data.cards.size()
              )
              || (
                request.auth.uid == currentMatch().currentPlayerUid
                && updatedMatch().lastActionBy == request.auth.uid
                && updatedMatch().lastActionTargetUid == playerId
                && updatedMatch().lastActionType in ['draw2', 'wild4', 'catchUno']
                && request.resource.data.cards.size()
                  == resource.data.cards.size() + updatedMatch().lastActionDrawnCards.size()
                && request.resource.data.cards.hasAll(resource.data.cards)
                && request.resource.data.cards.hasAll(updatedMatch().lastActionDrawnCards)
                && updatedMatch().handCounts[playerId] == request.resource.data.cards.size()
              )
            );

          allow delete: if false;
        }

        match /drawCards/{cardDocumentId} {
          function currentMatch() {
            return get(matchPath()).data;
          }

          function isNextDrawCard() {
            return currentMatch().drawIndex < currentMatch().drawOrder.size()
              && (
                currentMatch().drawOrder[currentMatch().drawIndex] == cardDocumentId
                || (
                  currentMatch().drawIndex + 1 < currentMatch().drawOrder.size()
                  && currentMatch().drawOrder[currentMatch().drawIndex + 1] == cardDocumentId
                )
                || (
                  currentMatch().drawIndex + 2 < currentMatch().drawOrder.size()
                  && currentMatch().drawOrder[currentMatch().drawIndex + 2] == cardDocumentId
                )
                || (
                  currentMatch().drawIndex + 3 < currentMatch().drawOrder.size()
                  && currentMatch().drawOrder[currentMatch().drawIndex + 3] == cardDocumentId
                )
              );
          }

          allow get: if isRoomMember(roomId)
            && currentMatch().status == 'playing'
            && currentMatch().currentPlayerUid == request.auth.uid
            && activeSessionData().status == 'playing'
            && activeSessionData().matchPlayerIds.hasAny([request.auth.uid])
            && isNextDrawCard();

          allow list: if false;

          allow create: if isRoomMember(roomId)
            && request.resource.data.keys().hasAll(['card', 'createdAt'])
            && request.resource.data.keys().hasOnly(['card', 'createdAt'])
            && validUnoCard(request.resource.data.card)
            && request.resource.data.createdAt is timestamp
            && (
              (
                updatedMatch().status == 'playing'
                && updatedMatch().dealerId == request.auth.uid
                && updatedMatch().drawOrder.hasAny([cardDocumentId])
                && updatedMatch().drawOrder.size() == 108
              )
              || (
                currentMatch().status == 'playing'
                && activeSessionData().status == 'playing'
                && activeSessionData().matchPlayerIds.hasAny([request.auth.uid])
                && updatedMatch().deckRecycledBy == request.auth.uid
                && updatedMatch().drawOrder.hasAny([cardDocumentId])
                && !currentMatch().drawOrder.hasAny([cardDocumentId])
              )
            );

          allow update, delete: if false;
        }
      }
    }

    match /roomInvites/{inviteCode} {
      // A signed-in user may look up an exact invite code to join a room.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'roomId',
          'roomName',
          'createdAt'
        ])
        && request.resource.data.roomId is string
        && request.resource.data.roomName is string
        && request.resource.data.createdAt is timestamp
        && existsAfter(roomPath(request.resource.data.roomId))
        && getAfter(roomPath(request.resource.data.roomId)).data.ownerId == request.auth.uid;

      allow update: if false;
      allow delete: if signedIn()
        && isRoomOwner(resource.data.roomId);
    }
  }
}
