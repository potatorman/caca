              && !request.resource.data.playerIds.hasAny([request.auth.uid])
              && onlyRemovesSelf(resource.data.playerIds, request.resource.data.playerIds)
              && onlyRemovesSelf(resource.data.readyIds, request.resource.data.readyIds)
              && matchPlayers(request.resource.data) == matchPlayers(resource.data)
              && spectators(request.resource.data) == spectators(resource.data)
              && request.resource.data.countdownEndsAt == null
