              && request.resource.data.playerIds.size() >= 1
              && request.resource.data.hostId == request.resource.data.playerIds[0]
              && onlyRemovesSelf(matchPlayers(resource.data), request.resource.data.matchPlayerIds)
              && request.resource.data.matchPlayerIds.size() == 0
              && request.resource.data.readyIds.size() == 0
              && request.resource.data.spectatorIds.size() == 0
              && request.resource.data.nextRoundPlayerIds.size() == 0
              && request.resource.data.nextRoundReadyIds.size() == 0
              && request.resource.data.round == resource.data.round + 1
              && request.resource.data.startedAt == null
              && request.resource.data.countdownEndsAt == null
              && request.resource.data.finishedAt == null
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
