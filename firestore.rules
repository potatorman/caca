rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }

    function memberPath(roomId, userId) {
      return /databases/$(database)/documents/rooms/$(roomId)/members/$(userId);
    }

    function userRoomPath(userId, roomId) {
      return /databases/$(database)/documents/users/$(userId)/rooms/$(roomId);
    }

    function banPath(roomId, userId) {
      return /databases/$(database)/documents/rooms/$(roomId)/bans/$(userId);
    }

    function invitePath(inviteCode) {
      return /databases/$(database)/documents/roomInvites/$(inviteCode);
    }

    function isRoomOwner(roomId) {
      return signedIn()
        && exists(roomPath(roomId))
        && get(roomPath(roomId)).data.ownerId == request.auth.uid;
    }

    function isRoomMember(roomId) {
      return signedIn()
        && exists(memberPath(roomId, request.auth.uid))
        && get(memberPath(roomId, request.auth.uid)).data.get('role', 'member')
          in ['owner', 'member', 'admin'];
    }

    function isActiveAdminRecord(memberData) {
      return memberData.get('role', 'member') == 'admin'
        && (
          memberData.get('adminExpiresAt', null) == null
          || memberData.get('adminExpiresAt', request.time) > request.time
        );
    }

    function isActiveRoomAdmin(roomId) {
      return signedIn()
        && exists(memberPath(roomId, request.auth.uid))
        && isActiveAdminRecord(
          get(memberPath(roomId, request.auth.uid)).data
        );
    }

    function isKickableByAdmin(memberData) {
      return memberData.get('role', 'member') == 'member'
        || (
          memberData.get('role', 'member') == 'admin'
          && memberData.get('adminExpiresAt', null) != null
          && memberData.get('adminExpiresAt', request.time) <= request.time
        );
    }

    function canKickRoomMember(roomId, targetUserId) {
      return isRoomOwner(roomId)
        || (
          isActiveRoomAdmin(roomId)
          && exists(memberPath(roomId, targetUserId))
          && isKickableByAdmin(
            get(memberPath(roomId, targetUserId)).data
          )
        );
    }

    function validNickname(value) {
      return value is string && value.size() >= 2 && value.size() <= 24;
    }

    function validAvatarData(value) {
      return value == null
        || (value is string && value.size() <= 120000);
    }

    function validJumpscareImage(value) {
      return value == null
        || (
          value is string
          && value.size() <= 180000
          && value.matches('^data:image/(webp|jpeg);base64,[A-Za-z0-9+/=]+$')
        );
    }

    // User profiles are readable by authenticated users because room members
    // and chat messages display each other's public nickname and avatar.
    match /users/{userId} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'username',
          'usernameLower',
          'nickname',
          'createdAt'
        ])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9_]{3,20}$')
        && request.resource.data.usernameLower is string
        && request.resource.data.usernameLower.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.nickname == request.resource.data.username
        && request.resource.data.createdAt is timestamp;

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nickname',
          'avatarId',
          'avatarData'
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['nickname'])
          || validNickname(request.resource.data.nickname)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['avatarId'])
          || (
            request.resource.data.avatarId is string
            && request.resource.data.avatarId.size() <= 32
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['avatarData'])
          || validAvatarData(request.resource.data.get('avatarData', null))
        );

      allow delete: if signedIn() && request.auth.uid == userId;

      match /rooms/{roomId} {
        allow get, list: if signedIn() && request.auth.uid == userId;

        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['name', 'role', 'joinedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 30
          && request.resource.data.role in ['owner', 'member']
          && request.resource.data.joinedAt is timestamp
          && existsAfter(roomPath(roomId))
          && existsAfter(memberPath(roomId, userId))
          && (
            (
              request.resource.data.role == 'owner'
              && getAfter(roomPath(roomId)).data.ownerId == userId
              && getAfter(memberPath(roomId, userId)).data.role == 'owner'
            )
            || (
              request.resource.data.role == 'member'
              && getAfter(memberPath(roomId, userId)).data.role == 'member'
            )
          );

        allow update: if false;

        allow delete: if signedIn()
          && !existsAfter(memberPath(roomId, userId))
          && (
            request.auth.uid == userId
            || isRoomOwner(roomId)
            || (
              canKickRoomMember(roomId, userId)
              && userId != request.auth.uid
            )
          );
      }
      // Each user owns a private library of exactly three compressed images.
      match /jumpscares/{libraryId} {
        allow get: if signedIn()
          && request.auth.uid == userId
          && libraryId == 'library';
        allow list: if false;

        allow create, update: if signedIn()
          && request.auth.uid == userId
          && libraryId == 'library'
          && request.resource.data.keys().hasAll([
            'slot1', 'slot2', 'slot3', 'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'slot1', 'slot2', 'slot3', 'updatedAt'
          ])
          && validJumpscareImage(request.resource.data.slot1)
          && validJumpscareImage(request.resource.data.slot2)
          && validJumpscareImage(request.resource.data.slot3)
          && request.resource.data.updatedAt is timestamp;

        allow delete: if signedIn()
          && request.auth.uid == userId
          && libraryId == 'library';
      }
    }

    match /rooms/{roomId} {
      allow get: if signedIn()
        && (
          resource.data.ownerId == request.auth.uid
          || isRoomMember(roomId)
        );

      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'name',
          'ownerId',
          'inviteCode',
          'createdAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 30
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.matches('^[A-HJ-NP-Z2-9]{8}$')
        && request.resource.data.createdAt is timestamp;

      allow update: if false;

      // The owner deletes the room only after its child documents and the
      // owner's own membership/list entry have been removed.
      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && !existsAfter(memberPath(roomId, request.auth.uid))
        && !existsAfter(userRoomPath(request.auth.uid, roomId));

      match /members/{memberId} {
        allow get, list: if signedIn()
          && (
            memberId == request.auth.uid
            || isRoomOwner(roomId)
            || isRoomMember(roomId)
          );

        allow create: if signedIn()
          && memberId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'username',
            'role',
            'joinedAt',
            'inviteCodeUsed'
          ])
          && request.resource.data.username is string
          && request.resource.data.role in ['owner', 'member']
          && request.resource.data.joinedAt is timestamp
          && existsAfter(userRoomPath(memberId, roomId))
          && (
            (
              request.resource.data.role == 'owner'
              && getAfter(roomPath(roomId)).data.ownerId == memberId
            )
            || (
              request.resource.data.role == 'member'
              && request.resource.data.inviteCodeUsed is string
              && get(invitePath(request.resource.data.inviteCodeUsed)).data.roomId == roomId
              && !exists(banPath(roomId, memberId))
            )
          );

        // A user can update only their own public room nickname.
        // The room owner alone can grant, renew or revoke admin permissions.
        allow update: if signedIn()
          && (
            (
              memberId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username'])
              && request.resource.data.username is string
              && request.resource.data.username.size() >= 2
              && request.resource.data.username.size() <= 24
            )
            || (
              isRoomOwner(roomId)
              && memberId != request.auth.uid
              && resource.data.get('role', 'member') != 'owner'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'role',
                'adminExpiresAt',
                'adminGrantedAt',
                'adminGrantedBy'
              ])
              && request.resource.data.role in ['admin', 'member']
              && (
                (
                  request.resource.data.role == 'admin'
                  && request.resource.data.adminGrantedBy == request.auth.uid
                  && request.resource.data.adminGrantedAt is timestamp
                  && (
                    request.resource.data.adminExpiresAt == null
                    || request.resource.data.adminExpiresAt is timestamp
                  )
                )
                || (
                  request.resource.data.role == 'member'
                  && request.resource.data.adminExpiresAt == null
                  && request.resource.data.adminGrantedAt == null
                  && request.resource.data.adminGrantedBy == null
                )
              )
            )
            // An admin may only demote their own account after the server-side expiry.
            || (
              memberId == request.auth.uid
              && resource.data.get('role', 'member') == 'admin'
              && resource.data.get('adminExpiresAt', null) is timestamp
              && request.time >= resource.data.adminExpiresAt
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'role',
                'adminExpiresAt',
                'adminGrantedAt',
                'adminGrantedBy'
              ])
              && request.resource.data.role == 'member'
              && request.resource.data.adminExpiresAt == null
              && request.resource.data.adminGrantedAt == null
              && request.resource.data.adminGrantedBy == null
            )
          );

        allow delete: if signedIn()
          && (
            // Members may leave their own room. The owner can also remove
            // their own membership only as part of deleting the whole room.
            (
              memberId == request.auth.uid
              && (
                resource.data.get('role', 'member') != 'owner'
                || (
                  isRoomOwner(roomId)
                  && !existsAfter(roomPath(roomId))
                  && !existsAfter(userRoomPath(memberId, roomId))
                )
              )
            )
            // Owners can remove any other member. Active admins can remove
            // ordinary members and expired admins, but never active admins.
            || (
              memberId != request.auth.uid
              && canKickRoomMember(roomId, memberId)
            )
          );
      }

      match /messages/{messageId} {
        allow read: if isRoomMember(roomId);

        allow create: if isRoomMember(roomId)
          && request.resource.data.keys().hasOnly([
            'text',
            'senderId',
            'senderName',
            'senderAvatarId',
            'createdAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 2000
          && request.resource.data.senderName is string
          && request.resource.data.senderAvatarId is string
          && request.resource.data.createdAt is timestamp;

        allow update: if isRoomMember(roomId)
          && resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'text',
            'editedAt'
          ])
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 2000
          && request.resource.data.editedAt is timestamp;

        allow delete: if isRoomMember(roomId)
          && (
            resource.data.senderId == request.auth.uid
            || isRoomOwner(roomId)
          );
      }

      match /bans/{bannedUserId} {
        // A banned user can verify their own ban; only the room owner can
        // enumerate the room's ban list or change ban records.
        allow get: if signedIn()
          && (
            bannedUserId == request.auth.uid
            || isRoomOwner(roomId)
          );

        allow list: if isRoomOwner(roomId);

        allow create: if isRoomOwner(roomId)
          && bannedUserId != request.auth.uid
          && request.resource.data.keys().hasOnly([
            'username',
            'bannedAt',
            'bannedBy'
          ])
          && request.resource.data.username is string
          && request.resource.data.bannedAt is timestamp
          && request.resource.data.bannedBy == request.auth.uid;

        allow update: if false;
        allow delete: if isRoomOwner(roomId);
      }

      match /pranks/{prankId} {
        // Every room member receives live room-wide prank events.
        allow get: if isRoomMember(roomId);
        allow list: if false;

        // Only the room owner and an active room admin can send an effect.
        // A single fixed document is overwritten so room data cannot grow
        // with every prank click.
        allow create, update: if prankId == 'active'
          && (isRoomOwner(roomId) || isActiveRoomAdmin(roomId))
          && request.resource.data.keys().hasAll([
            'eventId',
            'type',
            'senderId',
            'senderName',
            'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'eventId',
            'type',
            'senderId',
            'senderName',
            'createdAt'
          ])
          && request.resource.data.eventId is string
          && request.resource.data.eventId.size() >= 8
          && request.resource.data.eventId.size() <= 80
          && request.resource.data.type in ['jumpscare', 'shake']
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() >= 1
          && request.resource.data.senderName.size() <= 24
          && request.resource.data.createdAt is timestamp;

        // The room owner removes the fixed event document during room deletion.
        allow delete: if isRoomOwner(roomId);
      }
      // Each room member can send an image to one eligible recipient.
      // Only the addressed user can read the incoming event.
      match /prankInbox/{recipientUid} {
        allow get: if signedIn()
          && recipientUid == request.auth.uid
          && isRoomMember(roomId);
        allow list: if false;

        allow create: if signedIn()
          && isRoomMember(roomId)
          && (isRoomOwner(roomId) || isActiveRoomAdmin(roomId))
          && recipientUid != request.auth.uid
          && recipientUid != get(roomPath(roomId)).data.ownerId
          && exists(memberPath(roomId, recipientUid))
          && (
            isRoomOwner(roomId)
            || isActiveRoomAdmin(roomId)
            || isKickableByAdmin(get(memberPath(roomId, recipientUid)).data)
          )
          && request.resource.data.keys().hasAll([
            'eventId', 'type', 'senderId', 'senderName', 'imageData', 'durationMs', 'sentAt'
          ])
          && request.resource.data.keys().hasOnly([
            'eventId', 'type', 'senderId', 'senderName', 'imageData', 'durationMs', 'sentAt'
          ])
          && request.resource.data.eventId is string
          && request.resource.data.eventId.size() >= 8
          && request.resource.data.eventId.size() <= 80
          && request.resource.data.type == 'custom-jumpscare'
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() >= 1
          && request.resource.data.senderName.size() <= 24
          && request.resource.data.imageData is string
          && validJumpscareImage(request.resource.data.imageData)
          && request.resource.data.durationMs is int
          && request.resource.data.durationMs in [3000, 5000, 10000, 15000]
          && request.resource.data.sentAt is timestamp;

        allow update: if signedIn()
          && isRoomMember(roomId)
          && (isRoomOwner(roomId) || isActiveRoomAdmin(roomId))
          && recipientUid != request.auth.uid
          && recipientUid != get(roomPath(roomId)).data.ownerId
          && exists(memberPath(roomId, recipientUid))
          && (
            isRoomOwner(roomId)
            || isActiveRoomAdmin(roomId)
            || isKickableByAdmin(get(memberPath(roomId, recipientUid)).data)
          )
          && resource.data.sentAt is timestamp
          && request.time > resource.data.sentAt + duration.value(5, 's')
          && request.resource.data.keys().hasAll([
            'eventId', 'type', 'senderId', 'senderName', 'imageData', 'durationMs', 'sentAt'
          ])
          && request.resource.data.keys().hasOnly([
            'eventId', 'type', 'senderId', 'senderName', 'imageData', 'durationMs', 'sentAt'
          ])
          && request.resource.data.eventId is string
          && request.resource.data.eventId.size() >= 8
          && request.resource.data.eventId.size() <= 80
          && request.resource.data.type == 'custom-jumpscare'
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() >= 1
          && request.resource.data.senderName.size() <= 24
          && request.resource.data.imageData is string
          && validJumpscareImage(request.resource.data.imageData)
          && request.resource.data.durationMs is int
          && request.resource.data.durationMs in [3000, 5000, 10000, 15000]
          && request.resource.data.sentAt is timestamp;

        allow delete: if signedIn()
          && (
            recipientUid == request.auth.uid
            || isRoomOwner(roomId)
            || (
              recipientUid != request.auth.uid
              && canKickRoomMember(roomId, recipientUid)
            )
          );
      }
      // One fixed game session per room. All members can read it to watch.
      match /gameSessions/{sessionId} {
        function onlyRemovesSelf(oldList, newList) {
          return oldList.hasAll(newList)
            && (
              oldList.size() == newList.size()
              || (
                oldList.size() == newList.size() + 1
                && oldList.hasAny([request.auth.uid])
                && !newList.hasAny([request.auth.uid])
              )
            );
        }

        function onlyAddsSelf(oldList, newList) {
          return newList.hasAll(oldList)
            && newList.size() == oldList.size() + 1
            && !oldList.hasAny([request.auth.uid])
            && newList.hasAny([request.auth.uid]);
        }

        function matchPlayers(data) {
          return data.keys().hasAny(['matchPlayerIds'])
            ? data.matchPlayerIds
            : (data.status in ['playing', 'results'] ? data.playerIds : []);
        }

        function spectators(data) {
          return data.keys().hasAny(['spectatorIds'])
            ? data.spectatorIds
            : [];
        }

        function validGameSession(data) {
          return data.keys().hasAll([
              'gameId', 'gameName', 'status', 'round', 'hostId',
              'playerIds', 'readyIds', 'nextRoundPlayerIds',
              'nextRoundReadyIds', 'createdAt', 'startedAt', 'updatedAt'
            ])
            && data.keys().hasOnly([
              'gameId', 'gameName', 'status', 'round', 'hostId',
              'playerIds', 'readyIds', 'nextRoundPlayerIds',
              'nextRoundReadyIds', 'matchPlayerIds', 'spectatorIds', 'resultReturnIds',
              'createdAt', 'startedAt', 'countdownEndsAt', 'finishedAt', 'updatedAt'
            ])
            && data.gameId is string && data.gameId.size() >= 3 && data.gameId.size() <= 32
            && data.gameName is string && data.gameName.size() >= 2 && data.gameName.size() <= 40
            && data.status in ['lobby', 'starting', 'playing', 'results']
            && data.round is int && data.round >= 1
            && data.hostId is string
            && data.playerIds is list && data.playerIds.size() <= 20
            && data.playerIds.toSet().size() == data.playerIds.size()
            && (data.gameId != 'uno' || data.playerIds.size() <= 10)
            && data.readyIds is list && data.readyIds.size() <= 20
            && data.readyIds.hasOnly(data.playerIds)
            && data.nextRoundPlayerIds is list && data.nextRoundPlayerIds.size() <= 20
            && data.nextRoundReadyIds is list && data.nextRoundReadyIds.size() <= 20
            && data.nextRoundReadyIds.hasOnly(data.nextRoundPlayerIds)
            && (
              !data.keys().hasAny(['resultReturnIds'])
              || (
                data.resultReturnIds is list
                && data.resultReturnIds.size() <= 10
                && data.resultReturnIds.toSet().size() == data.resultReturnIds.size()
                && data.resultReturnIds.hasOnly(
                  data.keys().hasAny(['matchPlayerIds']) ? data.matchPlayerIds : data.playerIds
                )
              )
            )
            && (
              !data.keys().hasAny(['matchPlayerIds'])
              || (
                data.matchPlayerIds is list
                && data.matchPlayerIds.size() <= 20
                && data.matchPlayerIds.hasOnly(data.playerIds)
                && (data.gameId != 'uno' || data.matchPlayerIds.size() <= 10)
              )
            )
            && (
              !data.keys().hasAny(['spectatorIds'])
              || (
                data.spectatorIds is list
                && data.spectatorIds.size() <= 10
                && data.spectatorIds.toSet().size() == data.spectatorIds.size()
              )
            )
            && (!data.keys().hasAny(['countdownEndsAt']) || data.countdownEndsAt == null || data.countdownEndsAt is timestamp)
            && (!data.keys().hasAny(['finishedAt']) || data.finishedAt == null || data.finishedAt is timestamp)
            && data.createdAt is timestamp
            && (data.startedAt == null || data.startedAt is timestamp)
            && data.updatedAt is timestamp;
        }

        function currentUnoMatchPath() {
          return /databases/$(database)/documents/rooms/$(roomId)/unoMatches/$(resource.data.round);
        }

        function resultReturns(data) {
          return data.keys().hasAny(['resultReturnIds'])
            ? data.resultReturnIds
            : [];
        }

        function unoNextLobbyRosterSize() {
          return resource.data.playerIds
            .concat(spectators(resource.data))
            .concat(resource.data.nextRoundPlayerIds)
            .toSet()
            .size();
        }

        // The first player may acknowledge a result while the session is still
        // "playing" (the match document is the authoritative win record).
        function canBeginUnoResultReturn() {
          return resource.data.gameId == 'uno'
            && resource.data.status == 'playing'
            && request.resource.data.status == 'results'
            && matchPlayers(resource.data).hasAny([request.auth.uid])
            && exists(currentUnoMatchPath())
            && get(currentUnoMatchPath()).data.roomId == roomId
            && get(currentUnoMatchPath()).data.round == resource.data.round
            && get(currentUnoMatchPath()).data.status == 'results'
            && get(currentUnoMatchPath()).data.winnerId is string
            && matchPlayers(resource.data).hasAny([get(currentUnoMatchPath()).data.winnerId])
            && request.resource.data.resultReturnIds is list
            && request.resource.data.resultReturnIds.size() == 1
            && request.resource.data.resultReturnIds[0] == request.auth.uid
            && request.resource.data.playerIds == resource.data.playerIds
            && request.resource.data.readyIds == resource.data.readyIds
            && matchPlayers(request.resource.data) == matchPlayers(resource.data)
            && spectators(request.resource.data) == spectators(resource.data)
            && request.resource.data.nextRoundPlayerIds == resource.data.nextRoundPlayerIds
            && request.resource.data.nextRoundReadyIds == resource.data.nextRoundReadyIds
            && request.resource.data.hostId == resource.data.hostId
            && request.resource.data.finishedAt == get(currentUnoMatchPath()).data.finishedAt
            && request.resource.data.finishedAt is timestamp
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'resultReturnIds', 'finishedAt', 'updatedAt'
            ]);
        }

        // A result acknowledgement belongs to one player only. It never changes
        // the shared round or closes another player's table.
        function canAcknowledgeUnoResultReturn() {
          return resource.data.gameId == 'uno'
            && resource.data.status == 'results'
            && request.resource.data.status == 'results'
            && matchPlayers(resource.data).hasAny([request.auth.uid])
            && request.resource.data.resultReturnIds is list
            && request.resource.data.resultReturnIds.hasAll(resultReturns(resource.data))
            && request.resource.data.resultReturnIds.size() == resultReturns(resource.data).size() + 1
            && !resultReturns(resource.data).hasAny([request.auth.uid])
            && request.resource.data.resultReturnIds.hasAny([request.auth.uid])
            && request.resource.data.resultReturnIds.hasOnly(matchPlayers(resource.data))
            && request.resource.data.playerIds == resource.data.playerIds
            && request.resource.data.readyIds == resource.data.readyIds
            && matchPlayers(request.resource.data) == matchPlayers(resource.data)
            && spectators(request.resource.data) == spectators(resource.data)
            && request.resource.data.nextRoundPlayerIds == resource.data.nextRoundPlayerIds
            && request.resource.data.nextRoundReadyIds == resource.data.nextRoundReadyIds
            && request.resource.data.finishedAt == resource.data.finishedAt
            && request.resource.data.hostId == resource.data.hostId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['resultReturnIds', 'updatedAt']);
        }

        // The shared lobby advances only after every remaining match player
        // has individually acknowledged the result screen.
        function canCompleteUnoResultReturn() {
          return resource.data.gameId == 'uno'
            && resource.data.status == 'results'
            && request.resource.data.status == 'lobby'
            && matchPlayers(resource.data).size() >= 1
            && resultReturns(resource.data).hasAll(matchPlayers(resource.data))
            && resultReturns(resource.data).size() == matchPlayers(resource.data).size()
            && resultReturns(resource.data).hasAny([request.auth.uid])
            && request.resource.data.hostId == resource.data.hostId
            && request.resource.data.round == resource.data.round + 1
            && request.resource.data.playerIds.hasAll(resource.data.playerIds)
            && request.resource.data.playerIds.hasAll(spectators(resource.data))
            && request.resource.data.playerIds.hasAll(resource.data.nextRoundPlayerIds)
            && request.resource.data.playerIds.size() == unoNextLobbyRosterSize()
            && request.resource.data.playerIds.size() <= 10
            && request.resource.data.readyIds.size() == 0
            && request.resource.data.matchPlayerIds.size() == 0
            && request.resource.data.spectatorIds.size() == 0
            && request.resource.data.nextRoundPlayerIds.size() == 0
            && request.resource.data.nextRoundReadyIds.size() == 0
            && request.resource.data.resultReturnIds.size() == 0
            && request.resource.data.startedAt == null
            && request.resource.data.countdownEndsAt == null
            && request.resource.data.finishedAt == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'round', 'playerIds', 'readyIds', 'matchPlayerIds',
              'spectatorIds', 'nextRoundPlayerIds', 'nextRoundReadyIds',
              'resultReturnIds', 'startedAt', 'countdownEndsAt', 'finishedAt', 'updatedAt'
            ]);
        }

        // Atomic self-forfeit: the match update and lobby roster update are part
        // of one transaction. The lobby rule verifies the match's post-write state.
        function canSelfForfeitUnoSession() {
          return resource.data.gameId == 'uno'
            && resource.data.status == 'playing'
            && resource.data.playerIds.hasAny([request.auth.uid])
            && matchPlayers(resource.data).hasAny([request.auth.uid])
            && exists(currentUnoMatchPath())
            && getAfter(currentUnoMatchPath()).data.roomId == roomId
            && getAfter(currentUnoMatchPath()).data.round == resource.data.round
            && getAfter(currentUnoMatchPath()).data.forfeitedBy == request.auth.uid
            && getAfter(currentUnoMatchPath()).data.status == request.resource.data.status
            && getAfter(currentUnoMatchPath()).data.activePlayerIds is list
            && getAfter(currentUnoMatchPath()).data.activePlayerIds == matchPlayers(request.resource.data)
            && !getAfter(currentUnoMatchPath()).data.activePlayerIds.hasAny([request.auth.uid])
            && onlyRemovesSelf(resource.data.playerIds, request.resource.data.playerIds)
            && onlyRemovesSelf(matchPlayers(resource.data), matchPlayers(request.resource.data))
            && !request.resource.data.playerIds.hasAny([request.auth.uid])
            && !matchPlayers(request.resource.data).hasAny([request.auth.uid])
            && request.resource.data.playerIds.size() >= 1
            && request.resource.data.playerIds.hasAll(matchPlayers(request.resource.data))
            && resource.data.readyIds.hasAll(request.resource.data.readyIds)
            && spectators(request.resource.data) == spectators(resource.data)
            && request.resource.data.resultReturnIds.size() == 0
            && (
              request.resource.data.hostId == resource.data.hostId
              || (
                request.auth.uid == resource.data.hostId
                && request.resource.data.hostId == request.resource.data.playerIds[0]
              )
            )
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'hostId', 'playerIds', 'readyIds', 'matchPlayerIds',
              'nextRoundPlayerIds', 'nextRoundReadyIds', 'resultReturnIds',
              'finishedAt', 'updatedAt'
            ])
            && (
              (
                getAfter(currentUnoMatchPath()).data.status == 'results'
                && matchPlayers(request.resource.data).size() == 1
                && getAfter(currentUnoMatchPath()).data.winnerId
                  == matchPlayers(request.resource.data)[0]
                && request.resource.data.readyIds.size() == 0
                && request.resource.data.nextRoundPlayerIds.size() == 0
                && request.resource.data.nextRoundReadyIds.size() == 0
                && request.resource.data.finishedAt
                  == getAfter(currentUnoMatchPath()).data.finishedAt
                && request.resource.data.finishedAt is timestamp
              )
              || (
                getAfter(currentUnoMatchPath()).data.status == 'playing'
                && matchPlayers(request.resource.data).size() >= 2
                && request.resource.data.nextRoundPlayerIds == resource.data.nextRoundPlayerIds
                && request.resource.data.nextRoundReadyIds == resource.data.nextRoundReadyIds
                && request.resource.data.finishedAt == resource.data.finishedAt
              )
            );
        }

        // Recovery path for an older client that committed the match forfeit
        // but failed before synchronizing the lobby document.
        function canRecoverUnoForfeitSession() {
          return resource.data.gameId == 'uno'
            && resource.data.status == 'playing'
            && resource.data.playerIds.hasAny([request.auth.uid])
            && matchPlayers(resource.data).hasAny([request.auth.uid])
            && exists(currentUnoMatchPath())
            && get(currentUnoMatchPath()).data.roomId == roomId
            && get(currentUnoMatchPath()).data.round == resource.data.round
            && get(currentUnoMatchPath()).data.forfeitedBy == request.auth.uid
            && get(currentUnoMatchPath()).data.status == request.resource.data.status
            && get(currentUnoMatchPath()).data.activePlayerIds is list
            && get(currentUnoMatchPath()).data.activePlayerIds == matchPlayers(request.resource.data)
            && !get(currentUnoMatchPath()).data.activePlayerIds.hasAny([request.auth.uid])
            && onlyRemovesSelf(resource.data.playerIds, request.resource.data.playerIds)
            && onlyRemovesSelf(matchPlayers(resource.data), matchPlayers(request.resource.data))
            && !request.resource.data.playerIds.hasAny([request.auth.uid])
            && !matchPlayers(request.resource.data).hasAny([request.auth.uid])
            && request.resource.data.playerIds.size() >= 1
            && request.resource.data.playerIds.hasAll(matchPlayers(request.resource.data))
            && resource.data.readyIds.hasAll(request.resource.data.readyIds)
            && spectators(request.resource.data) == spectators(resource.data)
            && request.resource.data.resultReturnIds.size() == 0
            && (
              request.resource.data.hostId == resource.data.hostId
              || (
                request.auth.uid == resource.data.hostId
                && request.resource.data.hostId == request.resource.data.playerIds[0]
              )
            )
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'hostId', 'playerIds', 'readyIds', 'matchPlayerIds',
              'nextRoundPlayerIds', 'nextRoundReadyIds', 'resultReturnIds',
              'finishedAt', 'updatedAt'
            ])
            && (
              (
                get(currentUnoMatchPath()).data.status == 'results'
                && matchPlayers(request.resource.data).size() == 1
                && get(currentUnoMatchPath()).data.winnerId
                  == matchPlayers(request.resource.data)[0]
                && request.resource.data.readyIds.size() == 0
                && request.resource.data.nextRoundPlayerIds.size() == 0
                && request.resource.data.nextRoundReadyIds.size() == 0
                && request.resource.data.finishedAt == get(currentUnoMatchPath()).data.finishedAt
                && request.resource.data.finishedAt is timestamp
              )
              || (
                get(currentUnoMatchPath()).data.status == 'playing'
                && matchPlayers(request.resource.data).size() >= 2
                && request.resource.data.nextRoundPlayerIds == resource.data.nextRoundPlayerIds
                && request.resource.data.nextRoundReadyIds == resource.data.nextRoundReadyIds
                && request.resource.data.finishedAt == resource.data.finishedAt
              )
            );
        }
        allow get: if sessionId == 'active' && isRoomMember(roomId);
        allow list: if false;

        allow create: if sessionId == 'active'
          && isRoomMember(roomId)
          && validGameSession(request.resource.data)
          && request.resource.data.status == 'lobby'
          && request.resource.data.hostId == request.auth.uid
          && request.resource.data.playerIds.size() == 1
          && request.resource.data.playerIds[0] == request.auth.uid
          && request.resource.data.readyIds.size() == 0
          && request.resource.data.matchPlayerIds.size() == 0
          && request.resource.data.spectatorIds.size() == 0
          && request.resource.data.nextRoundPlayerIds.size() == 0
          && request.resource.data.nextRoundReadyIds.size() == 0
          && request.resource.data.round == 1
          && request.resource.data.startedAt == null
          && request.resource.data.countdownEndsAt == null
          && request.resource.data.finishedAt == null;

        allow update: if sessionId == 'active'
          && isRoomMember(roomId)
          && validGameSession(request.resource.data)
          && request.resource.data.gameId == resource.data.gameId
          && request.resource.data.gameName == resource.data.gameName
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            // UNO result acknowledgements and return-to-lobby lifecycle.
            canBeginUnoResultReturn()
            ||
            canAcknowledgeUnoResultReturn()
            ||
            canCompleteUnoResultReturn()
            ||
            // Atomic UNO forfeit plus recovery for an older partial forfeit.
            canSelfForfeitUnoSession()
            ||
            canRecoverUnoForfeitSession()
            ||
            // A room member joins the persistent lobby.
            (
              resource.data.status == 'lobby'
              && request.resource.data.status == 'lobby'
              && request.resource.data.hostId == resource.data.hostId
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['playerIds', 'readyIds', 'updatedAt'])
              && !resource.data.playerIds.hasAny([request.auth.uid])
              && onlyAddsSelf(resource.data.playerIds, request.resource.data.playerIds)
              && (resource.data.gameId != 'uno' || request.resource.data.playerIds.size() <= 10)
              && request.resource.data.readyIds == resource.data.readyIds
              && matchPlayers(request.resource.data) == matchPlayers(resource.data)
              && spectators(request.resource.data) == spectators(resource.data)
            )
            // A lobby member leaves the persistent lobby.
            || (
              resource.data.status == 'lobby'
              && request.resource.data.status == 'lobby'
              && request.resource.data.hostId == resource.data.hostId
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['playerIds', 'readyIds', 'updatedAt'])
              && resource.data.playerIds.hasAny([request.auth.uid])
              && onlyRemovesSelf(resource.data.playerIds, request.resource.data.playerIds)
              && onlyRemovesSelf(resource.data.readyIds, request.resource.data.readyIds)
              && matchPlayers(request.resource.data) == matchPlayers(resource.data)
              && spectators(request.resource.data) == spectators(resource.data)
            )
            // A player toggles their ready state.
            || (
              resource.data.status == 'lobby'
              && request.resource.data.status == 'lobby'
              && request.resource.data.hostId == resource.data.hostId
              && request.resource.data.playerIds == resource.data.playerIds
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['readyIds', 'updatedAt'])
              && (
                onlyAddsSelf(resource.data.readyIds, request.resource.data.readyIds)
                || onlyRemovesSelf(resource.data.readyIds, request.resource.data.readyIds)
              )
            )
            // The host leaves the lobby; the first remaining member inherits ownership.
            || (
              resource.data.status in ['lobby', 'starting']
              && request.resource.data.status == 'lobby'
              && request.auth.uid == resource.data.hostId
              && resource.data.playerIds.hasAny([request.auth.uid])
              && !request.resource.data.playerIds.hasAny([request.auth.uid])
              && request.resource.data.playerIds.size() >= 1
              && request.resource.data.hostId == request.resource.data.playerIds[0]
              && onlyRemovesSelf(resource.data.playerIds, request.resource.data.playerIds)
              && onlyRemovesSelf(resource.data.readyIds, request.resource.data.readyIds)
              && onlyRemovesSelf(matchPlayers(resource.data), matchPlayers(request.resource.data))
              && onlyRemovesSelf(spectators(resource.data), spectators(request.resource.data))
              && request.resource.data.countdownEndsAt == null
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'hostId', 'status', 'countdownEndsAt', 'playerIds', 'readyIds',
                'matchPlayerIds', 'spectatorIds', 'updatedAt'
              ])
            )
            // A previous-round host may no longer be in the current player list.
            // On leaving, ownership still moves to the first persistent lobby member.
            || (
              resource.data.status in ['lobby', 'starting']
              && request.resource.data.status == 'lobby'
              && request.auth.uid == resource.data.hostId
              && !resource.data.playerIds.hasAny([request.auth.uid])
              && request.resource.data.playerIds == resource.data.playerIds
              && request.resource.data.readyIds == resource.data.readyIds
              && request.resource.data.playerIds.size() >= 1
              && request.resource.data.hostId == request.resource.data.playerIds[0]
              && matchPlayers(request.resource.data) == matchPlayers(resource.data)
              && spectators(request.resource.data) == spectators(resource.data)
              && request.resource.data.countdownEndsAt == null
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['hostId', 'status', 'countdownEndsAt', 'updatedAt'])
            )
            // A ready player can cancel the countdown.
            || (
              resource.data.status == 'starting'
              && request.resource.data.status == 'lobby'
              && request.resource.data.hostId == resource.data.hostId
              && request.resource.data.playerIds == resource.data.playerIds
              && request.resource.data.readyIds.size() == resource.data.readyIds.size() - 1
              && onlyRemovesSelf(resource.data.readyIds, request.resource.data.readyIds)
              && !request.resource.data.readyIds.hasAny([request.auth.uid])
              && request.resource.data.countdownEndsAt == null
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'countdownEndsAt', 'readyIds', 'updatedAt'])
            )
            // If readiness changed while a countdown-completion request was in flight,
            // an expired countdown can safely return to the lobby instead of getting stuck.
            || (
              resource.data.status == 'starting'
              && request.resource.data.status == 'lobby'
              && request.time >= resource.data.countdownEndsAt
              && request.resource.data.hostId == resource.data.hostId
              && request.resource.data.playerIds == resource.data.playerIds
              && request.resource.data.readyIds == resource.data.readyIds
              && !request.resource.data.readyIds.hasAll(resource.data.playerIds)
              && matchPlayers(request.resource.data) == matchPlayers(resource.data)
              && spectators(request.resource.data) == spectators(resource.data)
